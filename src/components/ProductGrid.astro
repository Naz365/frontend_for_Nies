---

<section id="products-section" class="py-16 bg-clean">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Title -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold uppercase text-navy tracking-tight">
        Our <span class="text-flame">Products</span> & Solutions
      </h2>
      <div class="w-16 h-1 bg-flame mx-auto mt-3 mb-4 rounded-full"></div>
      <p class="text-gray-600 text-sm sm:text-base">
        High quality fire protection equipment, access control, surveillance, and industrial safety machinery.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap justify-center gap-2 mb-10">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`filter-btn px-4 py-2 text-xs font-bold uppercase rounded-md transition-all duration-200 ${
            idx === 0
              ? 'bg-flame text-white shadow'
              : 'bg-white text-navy hover:bg-flame hover:text-white border border-clean-border'
          }`}
          data-category={cat.slug}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {products.map(prod => (
        <div 
          class="product-card bg-white rounded-lg border border-clean-border overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 group"
          data-category={prod.category}
        >
          <div class="relative h-56 overflow-hidden bg-gray-100">
            <img 
              src={prod.image} 
              alt={prod.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-navy/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <a 
                href="/contact/" 
                class="px-4 py-2 bg-flame text-white text-xs font-extrabold uppercase rounded shadow"
              >
                Inquire Product
              </a>
            </div>
          </div>
          <div class="p-4 border-t border-clean-border">
            <span class="text-[10px] font-extrabold uppercase tracking-widest text-flame block mb-1">
              {prod.category.replace('-', ' ')}
            </span>
            <h3 class="text-sm font-bold uppercase text-navy tracking-tight line-clamp-1">
              {prod.title}
            </h3>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const productCards = document.querySelectorAll('.product-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');

      // Update button active state
      filterBtns.forEach(b => {
        b.classList.remove('bg-flame', 'text-white', 'shadow');
        b.classList.add('bg-white', 'text-navy', 'border', 'border-clean-border');
      });
      btn.classList.remove('bg-white', 'text-navy', 'border', 'border-clean-border');
      btn.classList.add('bg-flame', 'text-white', 'shadow');

      // Filter product items
      productCards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        if (cat === 'all' || cardCat === cat) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
