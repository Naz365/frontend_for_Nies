---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const navLinks = [
  { name: 'Home', href: `${base}` },
  { name: 'About Us', href: `${base}about-us/` },
  { name: 'Products', href: `${base}products/` },
  { name: 'Blog', href: `${base}blog/` },
  { name: 'Contact', href: `${base}contact/` },
  { name: 'Company Profile', href: `${base}company-profile/` }
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-clean-border shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href={base} class="flex items-center">
        <img 
          src={`${base}wp-content/uploads/2017/11/ni_logo-1.png`} 
          alt="N.I. Engineering Services Logo" 
          class="h-14 w-auto object-contain"
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center space-x-8">
        {navLinks.map(link => {
          const isActive = currentPath === link.href || (link.href !== base && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`text-sm font-bold tracking-wide uppercase transition-colors duration-200 ${
                isActive ? 'text-flame border-b-2 border-flame pb-1' : 'text-navy hover:text-flame'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- CTA Call Button -->
      <div class="hidden lg:flex items-center space-x-4">
        <a 
          href="tel:+8801711135731" 
          class="inline-flex items-center justify-center px-4 py-2 text-xs font-extrabold text-white bg-flame hover:bg-flame-hover rounded-md shadow uppercase tracking-wider transition-all duration-200"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          +880 1711 135 731
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="md:hidden flex items-center">
        <button
          id="mobile-menu-btn"
          type="button"
          class="text-navy hover:text-flame p-2 rounded-md focus:outline-none"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Nav Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden bg-navy text-white px-4 pt-2 pb-6 space-y-3 shadow-xl">
    {navLinks.map(link => (
      <a
        href={link.href}
        class="block px-3 py-2 text-base font-bold uppercase tracking-wider text-white hover:text-flame border-b border-navy-light"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-3">
      <a
        href="tel:+8801711135731"
        class="block text-center w-full py-3 bg-flame hover:bg-flame-hover text-white font-extrabold uppercase rounded shadow"
      >
        Call Us: +880 1711 135 731
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
