---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const navLinks = [
  { name: 'Home', href: `${base}` },
  { name: 'About Us', href: `${base}about-us/` },
  { name: 'Shop 🛒', href: `${base}shop/` },
  { name: 'Products', href: `${base}products/` },
  { name: 'Blog', href: `${base}blog/` },
  { name: 'Contact', href: `${base}contact/` },
  { name: 'Company Profile', href: `${base}company-profile/` }
];
---

<header class="sticky top-0 z-50 bg-white/95 dark:bg-navy-dark/95 backdrop-blur-md border-b border-clean-border dark:border-navy-light shadow-sm transition-colors duration-300">
  <div class="max-w-[1536px] w-full mx-auto px-4 sm:px-6 lg:px-10">
    <div class="flex items-center justify-between h-20 sm:h-22">
      <!-- Dynamic Logo (Switches to white logo variant in Dark Mode) -->
      <a href={base} class="flex items-center group flex-shrink-0">
        <img 
          src={`${base}wp-content/uploads/2017/11/ni_logo-1.png`} 
          alt="N.I. Engineering Services Logo" 
          class="h-12 sm:h-14 w-auto object-contain block dark:hidden transition-transform duration-300 group-hover:scale-105"
        />
        <img 
          src={`${base}wp-content/uploads/2017/11/logo-wh.png`} 
          alt="N.I. Engineering Services White Logo" 
          class="h-12 sm:h-14 w-auto object-contain hidden dark:block transition-transform duration-300 group-hover:scale-105"
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center space-x-4 lg:space-x-7 xl:space-x-9">
        {navLinks.map(link => {
          const isActive = currentPath === link.href || (link.href !== base && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`text-xs lg:text-sm font-bold tracking-wide uppercase transition-colors duration-200 whitespace-nowrap ${
                isActive 
                  ? 'text-flame border-b-2 border-flame pb-1' 
                  : 'text-navy dark:text-gray-200 hover:text-flame dark:hover:text-flame'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- CTA Call Button & Theme Toggle -->
      <div class="hidden md:flex items-center space-x-3 lg:space-x-4">
        <!-- Theme Toggle Button -->
        <button
          id="theme-toggle-btn"
          type="button"
          class="p-2.5 rounded-full bg-clean dark:bg-navy-light text-navy dark:text-amber-400 hover:bg-gray-200 dark:hover:bg-navy transition-all duration-200 border border-clean-border dark:border-navy-light shadow-sm"
          aria-label="Toggle Dark / Light Mode"
          title="Toggle Dark / Light Mode"
        >
          <!-- Sun Icon (visible in Dark mode) -->
          <svg id="theme-sun-icon" class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z" />
          </svg>
          <!-- Moon Icon (visible in Light mode) -->
          <svg id="theme-moon-icon" class="w-5 h-5 block dark:hidden text-navy" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
          </svg>
        </button>

        <a 
          href="tel:+8801700000000" 
          class="inline-flex items-center justify-center px-4 py-2 text-xs font-extrabold text-white bg-flame hover:bg-flame-hover rounded-md shadow uppercase tracking-wider transition-all duration-200"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          +880 1700-000000
        </a>
      </div>

      <!-- Mobile Menu & Theme Toggle -->
      <div class="md:hidden flex items-center space-x-2">
        <button
          id="theme-toggle-mobile"
          type="button"
          class="p-2 rounded-full bg-clean dark:bg-navy-light text-navy dark:text-amber-400 border border-clean-border dark:border-navy-light"
          aria-label="Toggle Theme"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden text-navy" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
          </svg>
        </button>

        <button
          id="mobile-menu-btn"
          type="button"
          class="text-navy dark:text-white hover:text-flame p-2 rounded-md focus:outline-none"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Nav Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden bg-navy dark:bg-navy-dark text-white px-4 pt-2 pb-6 space-y-3 shadow-xl border-t border-navy-light">
    {navLinks.map(link => (
      <a
        href={link.href}
        class="block px-3 py-2 text-base font-bold uppercase tracking-wider text-white hover:text-flame border-b border-navy-light"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-3">
      <a
        href="tel:+8801700000000"
        class="block text-center w-full py-3 bg-flame hover:bg-flame-hover text-white font-extrabold uppercase rounded shadow"
      >
        Call Us: +880 1700-000000
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }

  // Dark Mode Theme Toggle Logic
  function toggleTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  }

  document.getElementById('theme-toggle-btn')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
</script>
