---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const slides = [
  {
    title: "Prevent before Fighting Against Fire",
    subtitle: "Need help with that?",
    buttonText: "Know More",
    buttonLink: `${base}products/`,
    image: `${base}wp-content/uploads/2017/11/fire-safty-banner-mod-1.jpg`
  },
  {
    title: "Ensure Fire Safety, Save Life, Save Property",
    subtitle: "Complete Fire Protection & Safety Solutions",
    buttonText: "Our Products",
    buttonLink: `${base}products/`,
    image: `${base}wp-content/uploads/2017/11/mr-fire-safety-limited-fire-safety-training-shrewsbury-banner.jpg`
  },
  {
    title: "INTEGRATED SOLUTIONS FOR SECURITY & SURVEILLANCE",
    subtitle: "High Definition CCTV & Intruder Protection",
    buttonText: "Explore Systems",
    buttonLink: `${base}products/`,
    image: `${base}wp-content/uploads/2017/11/static1.squarespace.jpg`
  },
  {
    title: "convenient access control systems",
    subtitle: "Biometric & RFID Security Access",
    buttonText: "Learn More",
    buttonLink: `${base}products/`,
    image: `${base}wp-content/uploads/2017/11/Access-Control-Systems-1.jpg`
  }
];
---

<section class="relative bg-navy overflow-hidden">
  <!-- Slides Container -->
  <div id="hero-slider-container" class="relative min-h-[500px] lg:min-h-[600px] flex items-center">
    {slides.map((slide, index) => (
      <div 
        class={`hero-slide absolute inset-0 transition-opacity duration-700 ease-in-out bg-cover bg-center flex items-center ${
          index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'
        }`}
        style={`background-image: url('${slide.image}');`}
        data-slide-index={index}
      >
        <!-- Overlay -->
        <div class="absolute inset-0 bg-gradient-to-r from-navy-dark/90 via-navy/70 to-transparent"></div>

        <!-- Content -->
        <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 w-full">
          <div class="max-w-2xl">
            <span class="inline-block px-3 py-1 bg-flame/90 text-white text-xs font-black uppercase tracking-widest rounded mb-4 shadow">
              N.I. Engineering Services
            </span>
            <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight uppercase mb-4 drop-shadow">
              {slide.title}
            </h1>
            {slide.subtitle && (
              <p class="text-lg sm:text-xl text-gray-200 font-medium mb-8">
                {slide.subtitle}
              </p>
            )}
            <div class="flex flex-wrap gap-4">
              <a
                href={slide.buttonLink}
                class="inline-flex items-center px-8 py-4 bg-flame hover:bg-flame-hover text-white text-sm font-extrabold uppercase tracking-wider rounded shadow-lg transition-all duration-200 transform hover:-translate-y-0.5"
              >
                {slide.buttonText}
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
              <a
                href={`${base}contact/`}
                class="inline-flex items-center px-8 py-4 bg-white/10 hover:bg-white/20 text-white border border-white/30 text-sm font-extrabold uppercase tracking-wider rounded backdrop-blur transition-all duration-200"
              >
                Get In Touch
              </a>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Slider Indicators & Controls -->
  <div class="absolute bottom-6 left-0 right-0 z-30 flex items-center justify-center space-x-3">
    {slides.map((_, index) => (
      <button
        type="button"
        class={`slider-dot w-3 h-3 rounded-full transition-all duration-300 ${
          index === 0 ? 'bg-flame w-8' : 'bg-white/50 hover:bg-white'
        }`}
        data-slide-target={index}
        aria-label={`Go to slide ${index + 1}`}
      ></button>
    ))}
  </div>
</section>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.slider-dot');
  const total = slides.length;

  function showSlide(index: number) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('opacity-0', 'z-0');
        slide.classList.add('opacity-100', 'z-10');
      } else {
        slide.classList.remove('opacity-100', 'z-10');
        slide.classList.add('opacity-0', 'z-0');
      }
    });

    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.remove('bg-white/50', 'w-3');
        dot.classList.add('bg-flame', 'w-8');
      } else {
        dot.classList.remove('bg-flame', 'w-8');
        dot.classList.add('bg-white/50', 'w-3');
      }
    });
    currentSlide = index;
  }

  function nextSlide() {
    showSlide((currentSlide + 1) % total);
  }

  // Auto slide every 5 seconds
  let interval = setInterval(nextSlide, 5000);

  dots.forEach(dot => {
    dot.addEventListener('click', (e) => {
      const target = parseInt((e.currentTarget as HTMLElement).getAttribute('data-slide-target') || '0', 10);
      showSlide(target);
      clearInterval(interval);
      interval = setInterval(nextSlide, 5000);
    });
  });
</script>
