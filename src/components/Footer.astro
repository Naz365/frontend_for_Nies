---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<footer class="bg-navy text-white pt-16 pb-8 border-t-4 border-flame">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-navy-light">
      
      <!-- Col 1: About & Logo -->
      <div class="space-y-4">
        <img 
          src={`${base}wp-content/uploads/2017/11/logo-wh.png`} 
          alt="N.I. Engineering Services White Logo" 
          class="h-14 w-auto object-contain"
        />
        <p class="text-sm text-gray-300 leading-relaxed">
          N.I. Engineering Services is a leading Fire Protection, Engineering, Import, Supply and service Company offering a "one stop solution Provider" for client's safety & security requirements.
        </p>
        <div class="pt-2">
          <a 
            href="https://www.facebook.com/n.i.engineeringbd" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-white bg-blue-600 hover:bg-blue-700 px-3 py-2 rounded transition-colors"
          >
            <span>Follow on Facebook</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="space-y-4">
        <h3 class="text-lg font-bold uppercase tracking-wider text-flame border-l-2 border-flame pl-3">
          Quick Links
        </h3>
        <ul class="space-y-2 text-sm text-gray-300">
          <li><a href={base} class="hover:text-flame transition-colors">Home</a></li>
          <li><a href={`${base}about-us/`} class="hover:text-flame transition-colors">About Us</a></li>
          <li><a href={`${base}products/`} class="hover:text-flame transition-colors">Products & Solutions</a></li>
          <li><a href={`${base}contact/`} class="hover:text-flame transition-colors">Contact Us</a></li>
          <li><a href={`${base}company-profile/`} class="hover:text-flame transition-colors font-semibold text-white">Download Company Profile PDF</a></li>
        </ul>
      </div>

      <!-- Col 3: Contact Info -->
      <div class="space-y-4">
        <h3 class="text-lg font-bold uppercase tracking-wider text-flame border-l-2 border-flame pl-3">
          Visit Us
        </h3>
        <div class="space-y-3 text-sm text-gray-300">
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-flame flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>GA-85(Gr Floor), Middle Badda, Gulshan, Dhaka</span>
          </div>

          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-flame flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <div>
              <p class="font-bold text-white">+880 1711 135 731</p>
              <p>+880 1670 236 785</p>
              <p class="text-xs text-gray-400 mt-1">Tel: +88-02-9882326</p>
            </div>
          </div>

          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-flame flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <div class="text-xs">
              <p>info@example.com</p>
              <p>sales@example.com</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Col 4: Corporate Profile Download & Emergency -->
      <div class="space-y-4">
        <h3 class="text-lg font-bold uppercase tracking-wider text-flame border-l-2 border-flame pl-3">
          Company Profile
        </h3>
        <p class="text-xs text-gray-300 leading-relaxed">
          Download our complete official company credentials, fire equipment product catalog, and engineering certificates.
        </p>
        <a 
          href={`${base}wp-content/uploads/2017/11/Company_Profile.pdf`} 
          target="_blank"
          download
          class="inline-flex items-center justify-center w-full px-4 py-3 text-xs font-extrabold uppercase tracking-wider text-white bg-flame hover:bg-flame-hover rounded shadow transition-all duration-200"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          Download PDF Profile
        </a>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-gray-400">
      <p>Copyright © {year} | N. I. ENGINEERING SERVICES. All Rights Reserved.</p>
      <div class="mt-4 md:mt-0 flex space-x-6">
        <a href={`${base}privacy/`} class="hover:text-gray-200">Privacy Policy</a>
        <a href={`${base}terms/`} class="hover:text-gray-200">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
