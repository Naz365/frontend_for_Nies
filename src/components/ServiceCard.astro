---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<div class="bg-white dark:bg-navy-light p-8 rounded-xl border border-clean-border dark:border-navy-light shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex flex-col justify-between group">
  <div>
    <div class="w-14 h-14 bg-flame/10 dark:bg-flame/20 rounded-lg flex items-center justify-center text-flame mb-6 group-hover:bg-flame group-hover:text-white transition-colors duration-300">
      <Fragment set:html={icon} />
    </div>
    <h3 class="text-xl font-bold uppercase text-navy dark:text-white mb-3 tracking-wide">
      {title}
    </h3>
    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
      {description}
    </p>
  </div>
  <div class="mt-6 pt-4 border-t border-clean dark:border-navy-dark">
    <a href={`${base}products/`} class="inline-flex items-center text-xs font-extrabold uppercase text-flame group-hover:text-flame-hover">
      Learn More
      <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</div>
