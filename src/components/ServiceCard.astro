---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<div class="bg-white p-8 rounded-xl border border-clean-border shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex flex-col justify-between group">
  <div>
    <div class="w-14 h-14 bg-flame/10 rounded-lg flex items-center justify-center text-flame mb-6 group-hover:bg-flame group-hover:text-white transition-colors duration-300">
      <Fragment set:html={icon} />
    </div>
    <h3 class="text-xl font-bold uppercase text-navy mb-3 tracking-wide">
      {title}
    </h3>
    <p class="text-sm text-gray-600 leading-relaxed">
      {description}
    </p>
  </div>
  <div class="mt-6 pt-4 border-t border-clean">
    <a href="/products/" class="inline-flex items-center text-xs font-extrabold uppercase text-flame group-hover:text-flame-hover">
      Learn More
      <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</div>
