---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title="Admin CMS Web Panel | N.I. Engineering Services"
  description="Official Protected Web Management Panel for publishing blog posts, managing product safety catalogs, and site content."
>
  <!-- SECURITY AUTHENTICATION MODAL (LOCKED STATE) -->
  <div id="admin-auth-modal" class="fixed inset-0 z-50 bg-navy/95 backdrop-blur-lg flex items-center justify-center p-4">
    <div class="bg-white dark:bg-navy-dark max-w-md w-full rounded-2xl border border-clean-border dark:border-navy-light shadow-2xl p-8 space-y-6 text-center relative overflow-hidden transition-colors duration-300">
      <div class="w-16 h-16 bg-navy text-flame rounded-full flex items-center justify-center mx-auto shadow-inner text-2xl font-black">
        🔒
      </div>

      <div>
        <span class="text-xs font-black uppercase text-flame tracking-widest block mb-1">Protected Admin Gateway</span>
        <h2 class="text-2xl font-extrabold uppercase text-navy dark:text-white">Enter Admin Security Key</h2>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
          This portal is restricted to authorized N.I. Engineering Services administrators only.
        </p>
      </div>

      <form id="auth-form" class="space-y-4">
        <div>
          <input 
            type="password" 
            id="auth-password-input" 
            required 
            placeholder="Enter Admin Password"
            class="w-full px-4 py-3 text-center text-sm font-extrabold border-2 border-clean-border dark:border-navy-light rounded-xl focus:outline-none focus:border-flame bg-clean dark:bg-navy-light text-navy dark:text-white tracking-widest"
          />
        </div>

        <div id="auth-error-alert" class="hidden p-3 bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 text-xs font-bold rounded-lg">
          ❌ Access Denied: Incorrect Password.
        </div>

        <button 
          type="submit" 
          class="w-full py-3 bg-flame hover:bg-flame-hover text-white text-xs font-extrabold uppercase tracking-wider rounded-xl shadow-lg transition-all duration-200"
        >
          Unlock Admin Panel
        </button>
      </form>

    </div>
  </div>

  <!-- AUTHENTICATED ADMIN PANEL HEADER -->
  <section class="bg-navy text-white py-10 border-b border-flame">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-green-400 animate-pulse"></span>
          <span class="text-xs font-black uppercase text-flame tracking-widest">Authenticated Session</span>
        </div>
        <h1 class="text-3xl font-extrabold uppercase tracking-tight text-white mt-1">CMS Web Admin Panel</h1>
      </div>
      <div class="flex items-center space-x-3">
        <a href={`${base}blog/`} target="_blank" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-xs font-bold uppercase rounded border border-white/20 transition-all">
          View Live Blog ↗
        </a>
        <button id="btn-lock-session" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-bold uppercase rounded shadow transition-all flex items-center space-x-1">
          <span>🔒 Lock Panel</span>
        </button>
      </div>
    </div>
  </section>

  <!-- MAIN ADMIN WORKSPACE -->
  <section class="py-12 bg-clean dark:bg-navy-dark min-h-[700px] transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Sidebar Navigation -->
        <div class="lg:col-span-3 space-y-3">
          <div class="bg-white dark:bg-navy-light p-4 rounded-xl border border-clean-border dark:border-navy-light shadow-sm space-y-2">
            <button id="tab-btn-create" class="w-full text-left px-4 py-3 text-xs font-extrabold uppercase rounded-lg bg-flame text-white shadow transition-all">
              ✍️ Publish New Blog Post
            </button>
            <button id="tab-btn-list" class="w-full text-left px-4 py-3 text-xs font-extrabold uppercase rounded-lg bg-white dark:bg-navy text-navy dark:text-gray-200 hover:bg-clean dark:hover:bg-navy-light border border-clean-border dark:border-navy-light transition-all">
              📚 Manage Published Posts
            </button>
            <button id="tab-btn-orders" class="w-full text-left px-4 py-3 text-xs font-extrabold uppercase rounded-lg bg-white dark:bg-navy text-navy dark:text-gray-200 hover:bg-clean dark:hover:bg-navy-light border border-clean-border dark:border-navy-light transition-all flex items-center justify-between">
              <span>🛒 Customer Orders</span>
              <span id="orders-count-badge" class="px-2 py-0.5 bg-flame text-white text-[10px] rounded-full font-black">0</span>
            </button>
            <button id="tab-btn-products" class="w-full text-left px-4 py-3 text-xs font-extrabold uppercase rounded-lg bg-white dark:bg-navy text-navy dark:text-gray-200 hover:bg-clean dark:hover:bg-navy-light border border-clean-border dark:border-navy-light transition-all">
              📦 Product Catalog Manager
            </button>
            <button id="tab-btn-security" class="w-full text-left px-4 py-3 text-xs font-extrabold uppercase rounded-lg bg-white dark:bg-navy text-navy dark:text-gray-200 hover:bg-clean dark:hover:bg-navy-light border border-clean-border dark:border-navy-light transition-all">
              🔐 Security Settings
            </button>
          </div>

          <!-- Quick Security Status Box -->
          <div class="bg-navy dark:bg-navy-light p-5 rounded-xl border border-navy-light text-white space-y-2">
            <span class="text-[10px] font-black uppercase text-flame tracking-widest block">Access Control Protection</span>
            <p class="text-xs text-gray-300 leading-relaxed">
              Unwanted guests are automatically blocked by the encrypted admin passphrase guard.
            </p>
          </div>
        </div>

        <!-- Main Content Panel Area -->
        <div class="lg:col-span-9">
          
          <!-- TAB 1: CREATE NEW BLOG POST -->
          <div id="panel-create" class="bg-white dark:bg-navy p-6 sm:p-8 rounded-xl border border-clean-border dark:border-navy-light shadow-md space-y-6 text-navy dark:text-gray-100">
            <div class="border-b border-clean-border dark:border-navy-light pb-4">
              <h2 class="text-xl font-extrabold uppercase text-navy dark:text-white">Publish New Article</h2>
              <p class="text-xs text-gray-500 mt-1">Fill out the fields below to publish a new post to your website.</p>
            </div>

            <!-- Toast Success Message -->
            <div id="post-success-alert" class="hidden p-4 bg-green-500/10 border border-green-500/30 text-green-700 text-xs font-bold rounded-lg flex items-center justify-between">
              <span>🎉 Success! Your article has been published dynamically.</span>
              <a href={`${base}blog/`} target="_blank" class="underline hover:text-green-900">View Blog Page →</a>
            </div>

            <form id="blog-form" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">Article Title *</label>
                  <input 
                    type="text" 
                    id="post-title" 
                    required 
                    placeholder="e.g., Annual Fire Extinguisher Refilling Compliance Guide 2026"
                    class="w-full px-4 py-3 text-xs border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light text-navy dark:text-gray-100 rounded-lg focus:outline-none focus:border-flame font-medium"
                  />
                </div>

                <div>
                  <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">Category *</label>
                  <select id="post-category" class="w-full px-4 py-3 text-xs border border-clean-border dark:border-navy-light rounded-lg focus:outline-none focus:border-flame font-medium bg-white dark:bg-navy-light text-navy dark:text-gray-100">
                    <option value="Fire Safety">Fire Safety & Equipment</option>
                    <option value="Maintenance">Maintenance & Refilling</option>
                    <option value="CCTV & Access Control">CCTV & Access Control</option>
                    <option value="Civil Defence Guidelines">Civil Defence Guidelines</option>
                    <option value="Safety Awareness">Safety Awareness</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">Author Name</label>
                  <input 
                    type="text" 
                    id="post-author" 
                    value="N.I. Safety Team" 
                    class="w-full px-4 py-3 text-xs border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light text-navy dark:text-gray-100 rounded-lg focus:outline-none focus:border-flame font-medium"
                  />
                </div>

                <div>
                  <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">Thumbnail Image (Upload File or Paste URL) *</label>
                  
                  <!-- Drag & Drop Zone -->
                  <div 
                    id="dropzone-box" 
                    class="border-2 border-dashed border-gray-300 dark:border-navy-light hover:border-flame bg-clean dark:bg-navy-light hover:bg-white dark:hover:bg-navy rounded-xl p-4 text-center cursor-pointer transition-all duration-200 relative group"
                  >
                    <input type="file" id="file-input" accept="image/*" class="hidden" />
                    
                    <!-- Upload Prompt -->
                    <div id="dropzone-prompt" class="space-y-2 py-2">
                      <div class="w-10 h-10 rounded-full bg-flame/10 text-flame flex items-center justify-center mx-auto text-xl">
                        📸
                      </div>
                      <p class="text-xs font-bold text-navy dark:text-gray-200">
                        <span class="text-flame">Click to browse</span> or drag & drop image here
                      </p>
                      <p class="text-[10px] text-gray-400">Auto-hosted DataURL / ImgBB ready (PNG, JPG, WEBP, GIF)</p>
                    </div>

                    <!-- Live Image Preview -->
                    <div id="dropzone-preview" class="hidden relative rounded-lg overflow-hidden border border-clean-border dark:border-navy-light shadow-inner max-h-48">
                      <img id="preview-img" src="" alt="Uploaded Thumbnail Preview" class="w-full h-40 object-cover" />
                      <button 
                        type="button" 
                        id="btn-clear-image"
                        class="absolute top-2 right-2 bg-red-600 hover:bg-red-700 text-white text-[10px] font-extrabold uppercase px-2.5 py-1 rounded shadow transition-all"
                      >
                        ✕ Change Image
                      </button>
                    </div>
                  </div>

                  <!-- Direct URL Input Fallback -->
                  <div class="mt-2 flex items-center space-x-2">
                    <span class="text-[10px] text-gray-400 uppercase font-semibold">Image URL:</span>
                    <input 
                      type="text" 
                      id="post-thumbnail" 
                      value={`${base}wp-content/uploads/2017/05/fire-detection-alarm-system.jpg`}
                      class="flex-1 px-3 py-1.5 text-[11px] border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light text-navy dark:text-gray-100 rounded focus:outline-none focus:border-flame font-medium"
                      placeholder="Paste image link or drop file above..."
                    />
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">Short Summary (1-2 Sentences) *</label>
                <textarea 
                  id="post-summary" 
                  rows="2" 
                  required
                  placeholder="Provide a concise description that will appear on the blog listing card..."
                  class="w-full px-4 py-3 text-xs border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light text-navy dark:text-gray-100 rounded-lg focus:outline-none focus:border-flame font-medium"
                ></textarea>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">Full Article Body Content (HTML / Text) *</label>
                <textarea 
                  id="post-content" 
                  rows="10" 
                  required
                  placeholder="Write the full content of your article here. HTML tags like <p>, <h3>, <ul>, and <strong> are supported..."
                  class="w-full px-4 py-3 text-xs font-mono border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light text-navy dark:text-gray-100 rounded-lg focus:outline-none focus:border-flame"
                ></textarea>
              </div>

              <div class="pt-4 flex items-center justify-between border-t border-clean-border">
                <button 
                  type="reset" 
                  class="px-5 py-3 text-xs font-bold text-gray-500 hover:text-navy uppercase transition-colors"
                >
                  Clear Fields
                </button>
                <button 
                  type="submit" 
                  class="px-8 py-3 bg-flame hover:bg-flame-hover text-white text-xs font-extrabold uppercase rounded-lg shadow-md transition-all duration-200"
                >
                  🚀 Publish Article Live
                </button>
              </div>
            </form>
          </div>

          <!-- TAB 2: MANAGE POSTS LIST -->
          <div id="panel-list" class="hidden bg-white dark:bg-navy p-6 sm:p-8 rounded-xl border border-clean-border dark:border-navy-light shadow-md space-y-6 text-navy dark:text-gray-100">
            <div class="flex items-center justify-between border-b border-clean-border dark:border-navy-light pb-4">
              <div>
                <h2 class="text-xl font-extrabold uppercase text-navy dark:text-white">Published Articles</h2>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Manage, edit, or remove published articles from your website.</p>
              </div>
              <span id="posts-count-badge" class="px-3 py-1 bg-navy dark:bg-flame text-white text-xs font-extrabold rounded-full">
                0 Posts
              </span>
            </div>

            <div id="posts-list-container" class="space-y-4">
              <!-- Dynamically populated via JS -->
            </div>
          </div>

          <!-- TAB 3: PRODUCT CATALOG MANAGER -->
          <div id="panel-products" class="hidden bg-white dark:bg-navy p-6 sm:p-8 rounded-xl border border-clean-border dark:border-navy-light shadow-md space-y-6 text-navy dark:text-gray-100">
            <div class="border-b border-clean-border dark:border-navy-light pb-4">
              <h2 class="text-xl font-extrabold uppercase text-navy dark:text-white">Product Catalog Manager</h2>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Add custom safety equipment and industrial items to your website product list.</p>
            </div>

            <form id="product-form" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">Product Title *</label>
                  <input type="text" id="prod-title" required placeholder="e.g., FM-200 Fire Suppression Gas System" class="w-full px-4 py-3 text-xs border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light text-navy dark:text-gray-100 rounded-lg focus:outline-none focus:border-flame" />
                </div>
                <div>
                  <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">Category *</label>
                  <select id="prod-category" class="w-full px-4 py-3 text-xs border border-clean-border dark:border-navy-light rounded-lg focus:outline-none focus:border-flame bg-white dark:bg-navy-light text-navy dark:text-gray-100">
                    <option value="fire-extinguishers">FIRE EXTINGUISHERS</option>
                    <option value="suppression-system">SUPPRESSION SYSTEM</option>
                    <option value="alarm-systems">ALARM SYSTEMS</option>
                    <option value="cctv">CCTV</option>
                    <option value="access-control">ACCESS CONTROL</option>
                    <option value="fire-hydrant">FIRE HYDRANT</option>
                    <option value="firefighting-equipment">FIREFIGHTING EQUIPMENT</option>
                    <option value="generator">GENERATOR</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">Selling Price (in BDT ৳) *</label>
                  <input type="number" id="prod-price" required placeholder="e.g. 2800" class="w-full px-4 py-3 text-xs border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light text-navy dark:text-gray-100 rounded-lg focus:outline-none focus:border-flame font-medium" />
                </div>
                <div>
                  <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">Original Regular Price (Optional Strikethrough ৳)</label>
                  <input type="number" id="prod-orig-price" placeholder="e.g. 3200" class="w-full px-4 py-3 text-xs border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light text-navy dark:text-gray-100 rounded-lg focus:outline-none focus:border-flame font-medium" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">Product Image Path / URL *</label>
                <input type="text" id="prod-image" required value={`${base}wp-content/uploads/2017/11/fire-suppression-system.jpg`} class="w-full px-4 py-3 text-xs border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light text-navy dark:text-gray-100 rounded-lg focus:outline-none focus:border-flame" />
              </div>

              <div>
                <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">Short Description *</label>
                <textarea id="prod-desc" rows="2" required placeholder="Brief specifications or safety compliance features..." class="w-full px-4 py-3 text-xs border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light text-navy dark:text-gray-100 rounded-lg focus:outline-none focus:border-flame font-medium"></textarea>
              </div>

              <div id="prod-success-alert" class="hidden p-3 bg-green-500/10 border border-green-500/30 text-green-700 dark:text-green-400 text-xs font-bold rounded-lg">
                🎉 Product & Price added to your E-Commerce Shop store successfully!
              </div>

              <div class="flex justify-end pt-2">
                <button type="submit" class="px-8 py-3 bg-navy dark:bg-flame hover:bg-navy-dark text-white text-xs font-extrabold uppercase rounded-lg shadow">
                  + Add Product & Price To Store
                </button>
              </div>
            </form>
          </div>

          <!-- TAB 5: CUSTOMER ORDERS MANAGER -->
          <div id="panel-orders" class="hidden bg-white dark:bg-navy p-6 sm:p-8 rounded-xl border border-clean-border dark:border-navy-light shadow-md space-y-6 text-navy dark:text-gray-100">
            <div class="flex items-center justify-between border-b border-clean-border dark:border-navy-light pb-4">
              <div>
                <h2 class="text-xl font-extrabold uppercase text-navy dark:text-white">Customer E-Commerce Orders</h2>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Real-time incoming orders, cash-on-delivery requests, and customer contact details.</p>
              </div>
              <button id="btn-refresh-orders" type="button" class="px-3 py-1.5 bg-navy dark:bg-navy-light text-white text-xs font-extrabold uppercase rounded border border-navy-light hover:bg-flame transition-all">
                🔄 Refresh Orders
              </button>
            </div>

            <div id="admin-orders-container" class="space-y-4">
              <!-- Dynamically populated via JS -->
            </div>
          </div>

          <!-- TAB 4: SECURITY SETTINGS -->
          <div id="panel-security" class="hidden bg-white dark:bg-navy p-6 sm:p-8 rounded-xl border border-clean-border dark:border-navy-light shadow-md space-y-6 text-navy dark:text-gray-100">
            <div class="border-b border-clean-border dark:border-navy-light pb-4">
              <h2 class="text-xl font-extrabold uppercase text-navy dark:text-white">Security & Passcode Settings</h2>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Change your Admin Security Key to prevent unwanted access.</p>
            </div>

            <div id="sec-success-alert" class="hidden p-4 bg-green-500/10 border border-green-500/30 text-green-700 dark:text-green-400 text-xs font-bold rounded-lg">
              ✅ Admin Passcode updated successfully!
            </div>

            <form id="change-pass-form" class="space-y-4 max-w-md">
              <div>
                <label class="block text-xs font-bold uppercase text-navy dark:text-gray-200 mb-2">New Admin Password *</label>
                <input type="password" id="new-admin-pass" required placeholder="Enter new secret passcode" class="w-full px-4 py-3 text-xs border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light text-navy dark:text-gray-100 rounded-lg focus:outline-none focus:border-flame font-medium" />
              </div>
              <button type="submit" class="px-6 py-3 bg-navy dark:bg-flame text-white text-xs font-extrabold uppercase rounded-lg shadow">
                Update Admin Password
              </button>
            </form>
          </div>

        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  const AUTH_KEY = 'nies_admin_auth_pass';
  const AUTH_SESSION = 'nies_admin_session_active';
  const DEFAULT_PASS = 'NIES2026!';

  const STORAGE_KEY = 'nies_custom_blog_posts';

  // Initialize Password
  if (!localStorage.getItem(AUTH_KEY)) {
    localStorage.setItem(AUTH_KEY, DEFAULT_PASS);
  }

  const modal = document.getElementById('admin-auth-modal');
  const authForm = document.getElementById('auth-form');
  const authInput = document.getElementById('auth-password-input') as HTMLInputElement;
  const authError = document.getElementById('auth-error-alert');
  const btnLock = document.getElementById('btn-lock-session');

  // Check Auth State
  function checkAuth() {
    if (sessionStorage.getItem(AUTH_SESSION) === 'true') {
      if (modal) modal.classList.add('hidden');
    } else {
      if (modal) modal.classList.remove('hidden');
    }
  }

  // Handle Login Submission
  authForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const storedPass = localStorage.getItem(AUTH_KEY) || DEFAULT_PASS;
    if (authInput.value === storedPass) {
      sessionStorage.setItem(AUTH_SESSION, 'true');
      if (authError) authError.classList.add('hidden');
      if (modal) modal.classList.add('hidden');
      authInput.value = '';
    } else {
      if (authError) authError.classList.remove('hidden');
    }
  });

  // Handle Lock Session
  btnLock?.addEventListener('click', () => {
    sessionStorage.removeItem(AUTH_SESSION);
    checkAuth();
  });

  // Handle Change Password Form
  const changePassForm = document.getElementById('change-pass-form');
  const secAlert = document.getElementById('sec-success-alert');
  changePassForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const newPass = (document.getElementById('new-admin-pass') as HTMLInputElement).value;
    if (newPass) {
      localStorage.setItem(AUTH_KEY, newPass);
      if (secAlert) {
        secAlert.classList.remove('hidden');
        setTimeout(() => secAlert.classList.add('hidden'), 4000);
      }
      (changePassForm as HTMLFormElement).reset();
    }
  });

  // Default Mock Blog Posts
  const defaultPosts = [
    {
      id: 1,
      title: "Essential Fire Safety Maintenance Rules for Industrial Facilities",
      slug: "essential-fire-safety-maintenance",
      category: "Fire Safety",
      summary: "Regular maintenance and annual refilling of fire extinguishers are critical line-of-defense measures.",
      content: "<p>Fire is a serious threat to the physical safety and security of any workplace. Regular inspection and servicing using well-equipped workshops guarantee optimal operational readiness in emergency scenarios.</p>",
      thumbnail: "/frontend_for_Nies/wp-content/uploads/2017/05/fire-detection-alarm-system.jpg",
      published_at: "2026-07-01",
      author: "N.I. Safety Team"
    },
    {
      id: 2,
      title: "Why Modern Facilities Need Integrated CCTV & Access Control",
      slug: "integrated-cctv-and-access-control",
      category: "CCTV & Access Control",
      summary: "Learn how combining surveillance cameras with smart door access boosts facility protection.",
      content: "<p>INTEGRATED SOLUTIONS FOR SECURITY & SURVEILLANCE bring together real-time tracking, intruder detection, and central control room management.</p>",
      thumbnail: "/frontend_for_Nies/wp-content/uploads/2017/11/AccessControlSystems.jpg",
      published_at: "2026-07-15",
      author: "N.I. Safety Team"
    },
    {
      id: 3,
