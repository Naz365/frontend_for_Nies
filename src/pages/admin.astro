---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title="Admin CMS Web Panel | N.I. Engineering Services"
  description="Official Web Management Panel for publishing blog posts, managing product safety catalogs, and site content."
>
  <section class="bg-navy text-white py-10 border-b border-flame">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <span class="text-xs font-black uppercase text-flame tracking-widest block mb-1">Web Management System</span>
        <h1 class="text-3xl font-extrabold uppercase tracking-tight text-white">CMS Web Admin Panel</h1>
      </div>
      <div class="flex items-center space-x-3">
        <a href={`${base}blog/`} target="_blank" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-xs font-bold uppercase rounded border border-white/20 transition-all">
          View Live Blog ↗
        </a>
        <a href={`${base}products/`} target="_blank" class="px-4 py-2 bg-flame hover:bg-flame-hover text-white text-xs font-bold uppercase rounded shadow transition-all">
          View Products ↗
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 bg-clean min-h-[700px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Sidebar Navigation -->
        <div class="lg:col-span-3 space-y-3">
          <div class="bg-white p-4 rounded-xl border border-clean-border shadow-sm space-y-2">
            <button id="tab-btn-create" class="w-full text-left px-4 py-3 text-xs font-extrabold uppercase rounded-lg bg-flame text-white shadow transition-all">
              ✍️ Publish New Blog Post
            </button>
            <button id="tab-btn-list" class="w-full text-left px-4 py-3 text-xs font-extrabold uppercase rounded-lg bg-white text-navy hover:bg-clean border border-clean-border transition-all">
              📚 Manage Published Posts
            </button>
            <button id="tab-btn-products" class="w-full text-left px-4 py-3 text-xs font-extrabold uppercase rounded-lg bg-white text-navy hover:bg-clean border border-clean-border transition-all">
              📦 Product Catalog Manager
            </button>
          </div>

          <!-- Quick Tip Box -->
          <div class="bg-navy p-5 rounded-xl border border-navy-light text-white space-y-2">
            <span class="text-[10px] font-black uppercase text-flame tracking-widest block">Live Dynamic Publishing</span>
            <p class="text-xs text-gray-300 leading-relaxed">
              Posts created in this panel are saved dynamically and appear immediately on your live website's blog page.
            </p>
          </div>
        </div>

        <!-- Main Content Panel Area -->
        <div class="lg:col-span-9">
          
          <!-- TAB 1: CREATE NEW BLOG POST -->
          <div id="panel-create" class="bg-white p-6 sm:p-8 rounded-xl border border-clean-border shadow-md space-y-6">
            <div class="border-b border-clean-border pb-4">
              <h2 class="text-xl font-extrabold uppercase text-navy">Publish New Article</h2>
              <p class="text-xs text-gray-500 mt-1">Fill out the fields below to publish a new post to your website.</p>
            </div>

            <!-- Toast Success Message -->
            <div id="post-success-alert" class="hidden p-4 bg-green-500/10 border border-green-500/30 text-green-700 text-xs font-bold rounded-lg flex items-center justify-between">
              <span>🎉 Success! Your article has been published dynamically.</span>
              <a href={`${base}blog/`} target="_blank" class="underline hover:text-green-900">View Blog Page →</a>
            </div>

            <form id="blog-form" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Post Title -->
                <div>
                  <label class="block text-xs font-bold uppercase text-navy mb-2">Article Title *</label>
                  <input 
                    type="text" 
                    id="post-title" 
                    required 
                    placeholder="e.g., Annual Fire Extinguisher Refilling Compliance Guide 2026"
                    class="w-full px-4 py-3 text-xs border border-clean-border rounded-lg focus:outline-none focus:border-flame font-medium"
                  />
                </div>

                <!-- Category -->
                <div>
                  <label class="block text-xs font-bold uppercase text-navy mb-2">Category *</label>
                  <select id="post-category" class="w-full px-4 py-3 text-xs border border-clean-border rounded-lg focus:outline-none focus:border-flame font-medium bg-white">
                    <option value="Fire Safety">Fire Safety & Equipment</option>
                    <option value="Maintenance">Maintenance & Refilling</option>
                    <option value="CCTV & Access Control">CCTV & Access Control</option>
                    <option value="Civil Defence Guidelines">Civil Defence Guidelines</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <!-- Author -->
                <div>
                  <label class="block text-xs font-bold uppercase text-navy mb-2">Author Name</label>
                  <input 
                    type="text" 
                    id="post-author" 
                    value="N.I. Safety Team" 
                    class="w-full px-4 py-3 text-xs border border-clean-border rounded-lg focus:outline-none focus:border-flame font-medium"
                  />
                </div>

                <!-- Thumbnail Image URL -->
                <div>
                  <label class="block text-xs font-bold uppercase text-navy mb-2">Thumbnail Image URL</label>
                  <input 
                    type="text" 
                    id="post-thumbnail" 
                    placeholder={`${base}wp-content/uploads/2017/05/fire-detection-alarm-system.jpg`}
                    value={`${base}wp-content/uploads/2017/05/fire-detection-alarm-system.jpg`}
                    class="w-full px-4 py-3 text-xs border border-clean-border rounded-lg focus:outline-none focus:border-flame font-medium"
                  />
                </div>
              </div>

              <!-- Summary -->
              <div>
                <label class="block text-xs font-bold uppercase text-navy mb-2">Short Summary (1-2 Sentences) *</label>
                <textarea 
                  id="post-summary" 
                  rows="2" 
                  required
                  placeholder="Provide a concise description that will appear on the blog listing card..."
                  class="w-full px-4 py-3 text-xs border border-clean-border rounded-lg focus:outline-none focus:border-flame font-medium"
                ></textarea>
              </div>

              <!-- Article Body -->
              <div>
                <label class="block text-xs font-bold uppercase text-navy mb-2">Full Article Body Content (HTML / Text) *</label>
                <textarea 
                  id="post-content" 
                  rows="10" 
                  required
                  placeholder="Write the full content of your article here. HTML tags like <p>, <h3>, <ul>, and <strong> are fully supported..."
                  class="w-full px-4 py-3 text-xs font-mono border border-clean-border rounded-lg focus:outline-none focus:border-flame"
                ></textarea>
              </div>

              <div class="pt-4 flex items-center justify-between border-t border-clean-border">
                <button 
                  type="reset" 
                  class="px-5 py-3 text-xs font-bold text-gray-500 hover:text-navy uppercase transition-colors"
                >
                  Clear Fields
                </button>
                <button 
                  type="submit" 
                  class="px-8 py-3 bg-flame hover:bg-flame-hover text-white text-xs font-extrabold uppercase rounded-lg shadow-md transition-all duration-200"
                >
                  🚀 Publish Article Live
                </button>
              </div>
            </form>
          </div>

          <!-- TAB 2: MANAGE POSTS LIST -->
          <div id="panel-list" class="hidden bg-white p-6 sm:p-8 rounded-xl border border-clean-border shadow-md space-y-6">
            <div class="flex items-center justify-between border-b border-clean-border pb-4">
              <div>
                <h2 class="text-xl font-extrabold uppercase text-navy">Published Articles</h2>
                <p class="text-xs text-gray-500 mt-1">Manage, edit, or remove published articles from your website.</p>
              </div>
              <span id="posts-count-badge" class="px-3 py-1 bg-navy text-white text-xs font-extrabold rounded-full">
                0 Posts
              </span>
            </div>

            <div id="posts-list-container" class="space-y-4">
              <!-- Dynamically populated via JS -->
            </div>
          </div>

          <!-- TAB 3: PRODUCT CATALOG MANAGER -->
          <div id="panel-products" class="hidden bg-white p-6 sm:p-8 rounded-xl border border-clean-border shadow-md space-y-6">
            <div class="border-b border-clean-border pb-4">
              <h2 class="text-xl font-extrabold uppercase text-navy">Product Catalog Manager</h2>
              <p class="text-xs text-gray-500 mt-1">Add custom safety equipment and industrial items to your website product list.</p>
            </div>

            <form id="product-form" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-bold uppercase text-navy mb-2">Product Title *</label>
                  <input type="text" id="prod-title" required placeholder="e.g., FM-200 Fire Suppression Gas System" class="w-full px-4 py-3 text-xs border border-clean-border rounded-lg focus:outline-none focus:border-flame" />
                </div>
                <div>
                  <label class="block text-xs font-bold uppercase text-navy mb-2">Category *</label>
                  <select id="prod-category" class="w-full px-4 py-3 text-xs border border-clean-border rounded-lg focus:outline-none focus:border-flame bg-white">
                    <option value="fire-extinguishers">FIRE EXTINGUISHERS</option>
                    <option value="suppression-system">SUPPRESSION SYSTEM</option>
                    <option value="alarm-systems">ALARM SYSTEMS</option>
                    <option value="cctv">CCTV</option>
                    <option value="access-control">ACCESS CONTROL</option>
                    <option value="fire-hydrant">FIRE HYDRANT</option>
                    <option value="firefighting-equipment">FIREFIGHTING EQUIPMENT</option>
                    <option value="generator">GENERATOR</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase text-navy mb-2">Product Image Path *</label>
                <input type="text" id="prod-image" required value={`${base}wp-content/uploads/2017/11/fire-suppression-system.jpg`} class="w-full px-4 py-3 text-xs border border-clean-border rounded-lg focus:outline-none focus:border-flame" />
              </div>

              <div class="flex justify-end pt-2">
                <button type="submit" class="px-8 py-3 bg-navy hover:bg-navy-dark text-white text-xs font-extrabold uppercase rounded-lg shadow">
                  + Add Product To Catalog
                </button>
              </div>
            </form>
          </div>

        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  const STORAGE_KEY = 'nies_custom_blog_posts';
  const PRODUCT_STORAGE_KEY = 'nies_custom_products';

  // Preset Default Posts if empty
  const defaultPosts = [
    {
      id: 1,
      title: "Essential Fire Safety Maintenance Rules for Industrial Facilities",
      slug: "essential-fire-safety-maintenance",
      category: "Fire Safety",
      summary: "Regular maintenance and annual refilling of fire extinguishers are critical line-of-defense measures.",
      content: "<p>Fire is a serious threat to the physical safety and security of any workplace. Regular inspection and servicing using well-equipped workshops guarantee optimal operational readiness in emergency scenarios.</p>",
      thumbnail: "/frontend_for_Nies/wp-content/uploads/2017/05/fire-detection-alarm-system.jpg",
      published_at: "2026-07-01",
      author: "N.I. Safety Team"
    },
    {
      id: 2,
      title: "Why Modern Facilities Need Integrated CCTV & Access Control",
      slug: "integrated-cctv-and-access-control",
      category: "CCTV & Access Control",
      summary: "Learn how combining surveillance cameras with smart door access boosts facility protection.",
      content: "<p>INTEGRATED SOLUTIONS FOR SECURITY & SURVEILLANCE bring together real-time tracking, intruder detection, and central control room management.</p>",
      thumbnail: "/frontend_for_Nies/wp-content/uploads/2017/11/AccessControlSystems.jpg",
      published_at: "2026-07-15",
      author: "N.I. Safety Team"
    }
  ];

  function getStoredPosts() {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultPosts));
      return defaultPosts;
    }
    try {
      return JSON.parse(raw);
    } catch {
      return defaultPosts;
    }
  }

  function savePosts(posts: any[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(posts));
  }

  // Tab switching logic
  const btnCreate = document.getElementById('tab-btn-create');
  const btnList = document.getElementById('tab-btn-list');
  const btnProducts = document.getElementById('tab-btn-products');

  const panelCreate = document.getElementById('panel-create');
  const panelList = document.getElementById('panel-list');
  const panelProducts = document.getElementById('panel-products');

  function switchTab(activeBtn: HTMLElement, activePanel: HTMLElement) {
    [btnCreate, btnList, btnProducts].forEach(b => {
      if (b) {
        b.className = 'w-full text-left px-4 py-3 text-xs font-extrabold uppercase rounded-lg bg-white text-navy hover:bg-clean border border-clean-border transition-all';
      }
    });
    [panelCreate, panelList, panelProducts].forEach(p => {
      if (p) p.classList.add('hidden');
    });

    activeBtn.className = 'w-full text-left px-4 py-3 text-xs font-extrabold uppercase rounded-lg bg-flame text-white shadow transition-all';
    activePanel.classList.remove('hidden');

    if (activePanel === panelList) {
      renderPostsList();
    }
  }

  btnCreate?.addEventListener('click', () => switchTab(btnCreate, panelCreate!));
  btnList?.addEventListener('click', () => switchTab(btnList, panelList!));
  btnProducts?.addEventListener('click', () => switchTab(btnProducts, panelProducts!));

  // Blog Post Submission Handler
  const blogForm = document.getElementById('blog-form');
  const successAlert = document.getElementById('post-success-alert');

  blogForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const title = (document.getElementById('post-title') as HTMLInputElement).value;
    const category = (document.getElementById('post-category') as HTMLSelectElement).value;
    const author = (document.getElementById('post-author') as HTMLInputElement).value || 'N.I. Safety Team';
    const thumbnail = (document.getElementById('post-thumbnail') as HTMLInputElement).value;
    const summary = (document.getElementById('post-summary') as HTMLTextAreaElement).value;
    const content = (document.getElementById('post-content') as HTMLTextAreaElement).value;

    const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    const newPost = {
      id: Date.now(),
      title,
      slug,
      category,
      author,
      thumbnail,
      summary,
      content,
      published_at: new Date().toISOString().split('T')[0]
    };

    const currentPosts = getStoredPosts();
    currentPosts.unshift(newPost);
    savePosts(currentPosts);

    if (successAlert) {
      successAlert.classList.remove('hidden');
      setTimeout(() => successAlert.classList.add('hidden'), 5000);
    }

    (blogForm as HTMLFormElement).reset();
  });

  // Render Posts Manager List
  function renderPostsList() {
    const container = document.getElementById('posts-list-container');
    const badge = document.getElementById('posts-count-badge');
    const posts = getStoredPosts();

    if (badge) badge.textContent = `${posts.length} Posts`;
    if (!container) return;

    if (posts.length === 0) {
      container.innerHTML = `<p class="text-xs text-gray-500 py-8 text-center">No articles found. Create your first post using the editor!</p>`;
      return;
    }

    container.innerHTML = posts.map((p: any) => `
      <div class="p-4 border border-clean-border rounded-lg bg-clean flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center space-x-4">
          <img src="${p.thumbnail}" alt="${p.title}" class="w-16 h-16 object-cover rounded border" />
          <div>
            <span class="text-[10px] font-bold uppercase text-flame block">${p.category} • ${p.published_at}</span>
            <h3 class="text-sm font-bold text-navy line-clamp-1">${p.title}</h3>
            <p class="text-xs text-gray-500 line-clamp-1">${p.summary}</p>
          </div>
        </div>

        <div class="flex items-center space-x-2 flex-shrink-0">
          <button data-delete-id="${p.id}" class="delete-post-btn px-3 py-1.5 bg-red-500 hover:bg-red-600 text-white text-[10px] font-extrabold uppercase rounded shadow transition-all">
            Delete
          </button>
        </div>
      </div>
    `).join('');

    // Delete Event Listeners
    container.querySelectorAll('.delete-post-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = parseInt((e.currentTarget as HTMLElement).getAttribute('data-delete-id') || '0', 10);
        const updated = getStoredPosts().filter((p: any) => p.id !== id);
        savePosts(updated);
        renderPostsList();
      });
    });
  }

  // Initial tab Setup
  renderPostsList();
</script>
