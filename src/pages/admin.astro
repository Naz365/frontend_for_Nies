  function getStoredPosts() {
    const raw = localStorage.getItem(STORAGE_KEY);
    let posts = defaultPosts;
    if (raw) {
      try {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed) && parsed.length > 0) {
          defaultPosts.forEach(dp => {
            if (!parsed.some((p: any) => p.id === dp.id || p.slug === dp.slug)) {
              parsed.push(dp);
            }
          });
          posts = parsed;
        }
      } catch {
        posts = defaultPosts;
      }
    }
    localStorage.setItem(STORAGE_KEY, JSON.stringify(posts));
    return posts;
  }

  function savePosts(posts: any[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(posts));
  }

  // Tab switching logic
  const btnCreate = document.getElementById('tab-btn-create');
  const btnList = document.getElementById('tab-btn-list');
  const btnOrders = document.getElementById('tab-btn-orders');
  const btnProducts = document.getElementById('tab-btn-products');
  const btnSecurity = document.getElementById('tab-btn-security');

  const panelCreate = document.getElementById('panel-create');
  const panelList = document.getElementById('panel-list');
  const panelOrders = document.getElementById('panel-orders');
  const panelProducts = document.getElementById('panel-products');
  const panelSecurity = document.getElementById('panel-security');

  function switchTab(activeBtn: HTMLElement, activePanel: HTMLElement) {
    [btnCreate, btnList, btnOrders, btnProducts, btnSecurity].forEach(b => {
      if (b) {
        b.className = 'w-full text-left px-4 py-3 text-xs font-extrabold uppercase rounded-lg bg-white dark:bg-navy text-navy dark:text-gray-200 hover:bg-clean dark:hover:bg-navy-light border border-clean-border dark:border-navy-light transition-all flex items-center justify-between';
      }
    });
    [panelCreate, panelList, panelOrders, panelProducts, panelSecurity].forEach(p => {
      if (p) p.classList.add('hidden');
    });

    activeBtn.className = 'w-full text-left px-4 py-3 text-xs font-extrabold uppercase rounded-lg bg-flame text-white shadow transition-all flex items-center justify-between';
    activePanel.classList.remove('hidden');

    if (activePanel === panelList) {
      renderPostsList();
    } else if (activePanel === panelOrders) {
      renderOrdersList();
    }
  }

  btnCreate?.addEventListener('click', () => switchTab(btnCreate, panelCreate!));
  btnList?.addEventListener('click', () => switchTab(btnList, panelList!));
  btnOrders?.addEventListener('click', () => switchTab(btnOrders, panelOrders!));
  btnProducts?.addEventListener('click', () => switchTab(btnProducts, panelProducts!));
  btnSecurity?.addEventListener('click', () => switchTab(btnSecurity, panelSecurity!));
  document.getElementById('btn-refresh-orders')?.addEventListener('click', renderOrdersList);

  // Blog Post Submission Handler
  const blogForm = document.getElementById('blog-form');
  const successAlert = document.getElementById('post-success-alert');

  blogForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const title = (document.getElementById('post-title') as HTMLInputElement).value;
    const category = (document.getElementById('post-category') as HTMLSelectElement).value;
    const author = (document.getElementById('post-author') as HTMLInputElement).value || 'N.I. Safety Team';
    const thumbnail = (document.getElementById('post-thumbnail') as HTMLInputElement).value;
    const summary = (document.getElementById('post-summary') as HTMLTextAreaElement).value;
    const content = (document.getElementById('post-content') as HTMLTextAreaElement).value;

    const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    const newPost = {
      id: Date.now(),
      title,
      slug,
      category,
      author,
      thumbnail,
      summary,
      content,
      published_at: new Date().toISOString().split('T')[0]
    };

    const currentPosts = getStoredPosts();
    currentPosts.unshift(newPost);
    savePosts(currentPosts);

    if (successAlert) {
      successAlert.classList.remove('hidden');
      setTimeout(() => successAlert.classList.add('hidden'), 5000);
    }

    (blogForm as HTMLFormElement).reset();
    resetDropzone();
  });

  // Product & Price Submission Handler
  const productForm = document.getElementById('product-form');
  const prodSuccessAlert = document.getElementById('prod-success-alert');

  productForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const title = (document.getElementById('prod-title') as HTMLInputElement).value;
    const category_slug = (document.getElementById('prod-category') as HTMLSelectElement).value;
    const price = parseFloat((document.getElementById('prod-price') as HTMLInputElement).value) || 0;
    const origPriceVal = (document.getElementById('prod-orig-price') as HTMLInputElement).value;
    const original_price = origPriceVal ? parseFloat(origPriceVal) : undefined;
    const image = (document.getElementById('prod-image') as HTMLInputElement).value;
    const description = (document.getElementById('prod-desc') as HTMLTextAreaElement).value;

    const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    const category_name = category_slug.replace('-', ' ').toUpperCase();

    const newProduct = {
      id: Date.now(),
      title,
      slug,
      category_slug,
      category_name,
      price,
      original_price,
      in_stock: true,
      image,
      description
    };

    const PRODUCTS_STORAGE_KEY = 'nies_custom_products';
    let products: any[] = [];
    try {
      const stored = localStorage.getItem(PRODUCTS_STORAGE_KEY);
      products = stored ? JSON.parse(stored) : [];
    } catch (err) {
      products = [];
    }

    products.unshift(newProduct);
    localStorage.setItem(PRODUCTS_STORAGE_KEY, JSON.stringify(products));

    if (prodSuccessAlert) {
      prodSuccessAlert.classList.remove('hidden');
      setTimeout(() => prodSuccessAlert.classList.add('hidden'), 5000);
    }
    (productForm as HTMLFormElement).reset();
  });

  // DRAG & DROP THUMBNAIL UPLOADER LOGIC
  const dropzoneBox = document.getElementById('dropzone-box');
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const dropzonePrompt = document.getElementById('dropzone-prompt');
  const dropzonePreview = document.getElementById('dropzone-preview');
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const btnClearImage = document.getElementById('btn-clear-image');
  const postThumbnailInput = document.getElementById('post-thumbnail') as HTMLInputElement;

  function handleFile(file: File) {
    if (!file || !file.type.startsWith('image/')) return;
    const reader = new FileReader();
    reader.onload = (e) => {
      const dataUrl = e.target?.result as string;
      if (previewImg) previewImg.src = dataUrl;
      if (postThumbnailInput) postThumbnailInput.value = dataUrl;
      if (dropzonePrompt) dropzonePrompt.classList.add('hidden');
      if (dropzonePreview) dropzonePreview.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
  }

  function resetDropzone() {
    if (fileInput) fileInput.value = '';
    if (previewImg) previewImg.src = '';
    if (dropzonePreview) dropzonePreview.classList.add('hidden');
    if (dropzonePrompt) dropzonePrompt.classList.remove('hidden');
  }

  dropzoneBox?.addEventListener('click', (e) => {
    if (e.target !== btnClearImage && !btnClearImage?.contains(e.target as Node)) {
      fileInput?.click();
    }
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) {
      handleFile(fileInput.files[0]);
    }
  });

  ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
    dropzoneBox?.addEventListener(eventName, (e) => {
      e.preventDefault();
      e.stopPropagation();
    }, false);
  });

  ['dragenter', 'dragover'].forEach(eventName => {
    dropzoneBox?.addEventListener(eventName, () => {
      dropzoneBox.classList.add('border-flame', 'bg-flame/5');
    }, false);
  });

  ['dragleave', 'drop'].forEach(eventName => {
    dropzoneBox?.addEventListener(eventName, () => {
      dropzoneBox.classList.remove('border-flame', 'bg-flame/5');
    }, false);
  });

  dropzoneBox?.addEventListener('drop', (e: DragEvent) => {
    const dt = e.dataTransfer;
    if (dt && dt.files && dt.files[0]) {
      handleFile(dt.files[0]);
    }
  });

  btnClearImage?.addEventListener('click', (e) => {
    e.stopPropagation();
    resetDropzone();
    if (postThumbnailInput) postThumbnailInput.value = '';
  });

  // Render Posts Manager List
  function renderPostsList() {
    const container = document.getElementById('posts-list-container');
    const badge = document.getElementById('posts-count-badge');
    const posts = getStoredPosts();

    if (badge) badge.textContent = `${posts.length} Posts`;
    if (!container) return;

    if (posts.length === 0) {
      container.innerHTML = `<p class="text-xs text-gray-500 dark:text-gray-400 py-8 text-center">No articles found. Create your first post using the editor!</p>`;
      return;
    }

    container.innerHTML = posts.map((p: any) => `
      <div class="p-4 border border-clean-border dark:border-navy-light rounded-lg bg-clean dark:bg-navy-light flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center space-x-4">
          <img src="${p.thumbnail}" alt="${p.title}" class="w-16 h-16 object-cover rounded border border-clean-border dark:border-navy" />
          <div>
            <span class="text-[10px] font-bold uppercase text-flame block">${p.category} • ${p.published_at}</span>
            <h3 class="text-sm font-bold text-navy dark:text-white line-clamp-1">${p.title}</h3>
            <p class="text-xs text-gray-500 dark:text-gray-300 line-clamp-1">${p.summary}</p>
          </div>
        </div>

        <div class="flex items-center space-x-2 flex-shrink-0">
          <button data-delete-id="${p.id}" class="delete-post-btn px-3 py-1.5 bg-red-500 hover:bg-red-600 text-white text-[10px] font-extrabold uppercase rounded shadow transition-all">
            Delete
          </button>
        </div>
      </div>
    `).join('');

    container.querySelectorAll('.delete-post-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = parseInt((e.currentTarget as HTMLElement).getAttribute('data-delete-id') || '0', 10);
        const updated = getStoredPosts().filter((p: any) => p.id !== id);
        savePosts(updated);
        renderPostsList();
      });
    });
  }

  // Render Customer E-Commerce Orders
  const ORDERS_STORAGE_KEY = 'nies_customer_orders';

  function getStoredOrders() {
    try {
      const stored = localStorage.getItem(ORDERS_STORAGE_KEY);
      return stored ? JSON.parse(stored) : [];
    } catch {
      return [];
    }
  }

  function saveOrders(orders: any[]) {
    localStorage.setItem(ORDERS_STORAGE_KEY, JSON.stringify(orders));
  }

  function renderOrdersList() {
    const container = document.getElementById('admin-orders-container');
    const badge = document.getElementById('orders-count-badge');
    const orders = getStoredOrders();

    if (badge) badge.textContent = String(orders.length);
    if (!container) return;

    if (orders.length === 0) {
      container.innerHTML = `
        <div class="text-center py-12 space-y-2">
          <div class="text-3xl">🛒</div>
          <p class="text-xs font-bold text-gray-500 dark:text-gray-400">No customer orders received yet.</p>
          <p class="text-[10px] text-gray-400">When visitors add products to cart and checkout on /shop/, their orders will appear here live!</p>
        </div>
      `;
      return;
    }

    container.innerHTML = orders.map((o: any) => `
      <div class="p-5 border border-clean-border dark:border-navy-light rounded-xl bg-clean dark:bg-navy-light space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-clean-border dark:border-navy pb-3">
          <div>
            <span class="text-[10px] font-black uppercase text-flame tracking-widest block">${o.orderId} • ${o.orderDate}</span>
            <h3 class="text-base font-extrabold text-navy dark:text-white">${o.name}</h3>
            <p class="text-xs font-semibold text-gray-600 dark:text-gray-300">📞 ${o.phone} | 📍 ${o.address}</p>
          </div>
          <div class="flex items-center space-x-2">
            <span class="px-3 py-1 text-[10px] font-black uppercase rounded shadow ${o.status.includes('DELIVERED') ? 'bg-green-600 text-white' : 'bg-amber-500 text-navy'}">
              ${o.status}
            </span>
          </div>
        </div>

        <!-- Itemized Products List -->
        <div class="space-y-1.5 pl-2 border-l-2 border-flame">
          ${o.items.map((i: any) => `
            <div class="flex items-center justify-between text-xs text-navy dark:text-gray-200">
              <span>• ${i.title} (x${i.qty})</span>
              <span class="font-bold">৳ ${(i.price * i.qty).toLocaleString()} BDT</span>
            </div>
          `).join('')}
        </div>

        <!-- Total & Action Buttons -->
        <div class="pt-3 border-t border-clean-border dark:border-navy flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="text-xs">
            <span class="text-gray-500 dark:text-gray-400 uppercase font-bold">Total Payable Amount:</span>
            <span class="text-base font-black text-flame ml-2">৳ ${o.totalPrice.toLocaleString()} BDT</span>
          </div>

          <div class="flex items-center space-x-2">
            <a href="tel:${o.phone}" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-extrabold uppercase rounded shadow">
              📞 Call Customer
            </a>
            <button data-mark-delivered="${o.orderId}" class="px-3 py-1.5 bg-green-600 hover:bg-green-700 text-white text-[10px] font-extrabold uppercase rounded shadow">
              ✓ Mark Delivered
            </button>
            <button data-delete-order="${o.orderId}" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white text-[10px] font-extrabold uppercase rounded shadow">
              🗑️ Delete
            </button>
          </div>
        </div>
      </div>
    `).join('');

    // Attach Event Listeners to Order Actions
    container.querySelectorAll('[data-mark-delivered]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-mark-delivered');
        let orders = getStoredOrders();
        const target = orders.find((o: any) => o.orderId === id);
        if (target) {
          target.status = 'DELIVERED ✅';
          saveOrders(orders);
          renderOrdersList();
        }
      });
    });

    container.querySelectorAll('[data-delete-order]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-delete-order');
        let orders = getStoredOrders().filter((o: any) => o.orderId !== id);
        saveOrders(orders);
        renderOrdersList();
      });
    });
  }

  // Initial Auth & Render Setup
  checkAuth();
  renderPostsList();
  renderOrdersList();
</script>
