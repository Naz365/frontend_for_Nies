---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="NIES Enterprise ERP Platform | N.I. Engineering Services"
  description="Fire Protection & Compliance ERP Platform for N.I. Engineering Services (Double-entry stock ledger, NBR 15% VAT Invoicing, Equipment & Site Inventory)"
>
  <div class="min-h-screen bg-navy text-white py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-8">
      
      <!-- Top Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between bg-navy-dark p-6 rounded-xl border border-navy-light shadow-xl gap-4">
        <div class="flex items-center space-x-4">
          <img src="/wp-content/uploads/2017/11/logo-wh.png" alt="N.I. Logo" class="h-12 w-auto object-contain" />
          <div>
            <span class="text-xs font-black uppercase text-flame tracking-widest block">ERP System Module</span>
            <h1 class="text-2xl font-extrabold uppercase tracking-tight text-white">NIES Fire Protection ERP Platform</h1>
          </div>
        </div>

        <div class="flex items-center space-x-3">
          <span class="px-3 py-1 bg-flame/20 text-flame border border-flame/40 text-xs font-bold uppercase rounded-full">
            NBR 15% VAT Compliant
          </span>
          <a 
            href="#" 
            target="_blank"
            class="px-4 py-2 bg-flame hover:bg-flame-hover text-white text-xs font-extrabold uppercase rounded shadow transition-all"
          >
            Open Svelte 5 ERP App &rarr;
          </a>
        </div>
      </div>

      <!-- ERP Core Modules Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Module 1: Double-Entry Stock Ledger -->
        <div class="bg-navy-dark p-6 rounded-xl border border-navy-light space-y-3">
          <div class="w-10 h-10 bg-flame/10 text-flame rounded-lg flex items-center justify-center font-bold">
            01
          </div>
          <h3 class="text-base font-bold uppercase text-white">Double-Entry Stock Ledger</h3>
          <p class="text-xs text-gray-300 leading-relaxed">
            Tracks historical inventory movements from Goods Received Notes (GRN) to dispatches across project sites with strict referential locks.
          </p>
        </div>

        <!-- Module 2: NBR 15% VAT Invoicing -->
        <div class="bg-navy-dark p-6 rounded-xl border border-navy-light space-y-3">
          <div class="w-10 h-10 bg-flame/10 text-flame rounded-lg flex items-center justify-center font-bold">
            02
          </div>
          <h3 class="text-base font-bold uppercase text-white">NBR VAT Invoicing</h3>
          <p class="text-xs text-gray-300 leading-relaxed">
            Supports toggling NBR 15% VAT addition or VAT-Free (Exempt) invoicing on equipment quotes and delivery bills.
          </p>
        </div>

        <!-- Module 3: Extinguisher Refilling Workshop -->
        <div class="bg-navy-dark p-6 rounded-xl border border-navy-light space-y-3">
          <div class="w-10 h-10 bg-flame/10 text-flame rounded-lg flex items-center justify-center font-bold">
            03
          </div>
          <h3 class="text-base font-bold uppercase text-white">Refilling Workshop Logs</h3>
          <p class="text-xs text-gray-300 leading-relaxed">
            Schedules pressure testing, nitrogen purging, and chemical refilling for ABC, CO2, and Foam extinguishers.
          </p>
        </div>

        <!-- Module 4: Site Inventory & Dispatches -->
        <div class="bg-navy-dark p-6 rounded-xl border border-navy-light space-y-3">
          <div class="w-10 h-10 bg-flame/10 text-flame rounded-lg flex items-center justify-center font-bold">
            04
          </div>
          <h3 class="text-base font-bold uppercase text-white">Site Inventory Ledger</h3>
          <p class="text-xs text-gray-300 leading-relaxed">
            Monitors real-time stock balances across developer client sites (BTI, BRAC, Envoy, Radiant).
          </p>
        </div>

      </div>

      <!-- ERP Integration Summary -->
      <div class="bg-navy-dark p-8 rounded-xl border border-navy-light flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xs font-bold text-flame uppercase tracking-widest block mb-1">Decoupled Tech Stack</span>
          <h2 class="text-xl font-extrabold uppercase text-white">Laravel 12 REST API + SvelteKit 2 / Svelte 5</h2>
          <p class="text-xs text-gray-300 mt-2">
            The ERP backend runs on Laravel 12 API (`c:\Users\pc\Desktop\HFST Epr\backend`) with Svelte 5 Runes state management frontend (`c:\Users\pc\Desktop\HFST Epr\frontend`).
          </p>
        </div>

        <div class="flex items-center space-x-4 flex-shrink-0">
          <a 
            href="#" 
            target="_blank"
            class="px-6 py-3 bg-flame hover:bg-flame-hover text-white text-xs font-extrabold uppercase rounded shadow transition-all"
          >
            Launch NIES ERP App
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
