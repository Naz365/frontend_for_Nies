---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Material & PO Tracking Portal | N.I. Engineering Services"
  description="Material & Purchase Order Tracking Portal for N.I. Engineering Services (Developer site reconciliation, BTI R/A Bills, Supplied vs Billed inventory)"
>
  <div class="min-h-screen bg-navy text-white py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-8">
      
      <!-- Top Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between bg-navy-dark p-6 rounded-xl border border-navy-light shadow-xl gap-4">
        <div class="flex items-center space-x-4">
          <img src="/wp-content/uploads/2017/11/logo-wh.png" alt="N.I. Engineering Logo" class="h-12 w-auto object-contain" />
          <div>
            <span class="text-xs font-black uppercase text-flame tracking-widest block">portal.niengineeringbd.com</span>
            <h1 class="text-2xl font-extrabold uppercase tracking-tight text-white">Material & PO Tracking Portal</h1>
          </div>
        </div>

        <div class="flex items-center space-x-3">
          <span class="px-3 py-1 bg-green-500/20 text-green-400 border border-green-500/40 text-xs font-bold uppercase rounded-full">
            Active Workspace: BTI City Pointe-F
          </span>
          <a 
            href="/wp-content/uploads/2017/11/Company_Profile.pdf" 
            download
            class="px-4 py-2 bg-flame hover:bg-flame-hover text-white text-xs font-extrabold uppercase rounded shadow transition-all"
          >
            A4 Challan Creator
          </a>
        </div>
      </div>

      <!-- Operational Stats Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-navy-dark p-6 rounded-xl border border-navy-light shadow-md">
          <span class="text-xs font-bold uppercase text-gray-400 block mb-1">Active Client Sites</span>
          <div class="text-3xl font-black text-white">12 Sites</div>
          <span class="text-[10px] text-green-400 mt-2 block">Developer Clients (e.g. BTI, BRAC, Envoy)</span>
        </div>

        <div class="bg-navy-dark p-6 rounded-xl border border-navy-light shadow-md">
          <span class="text-xs font-bold uppercase text-gray-400 block mb-1">Total Supplied Value</span>
          <div class="text-3xl font-black text-white">৳ 4,850,000</div>
          <span class="text-[10px] text-gray-400 mt-2 block">Delivered Fire Safety Equipment</span>
        </div>

        <div class="bg-navy-dark p-6 rounded-xl border border-navy-light shadow-md">
          <span class="text-xs font-bold uppercase text-gray-400 block mb-1">Billed R/A Value</span>
          <div class="text-3xl font-black text-green-400">৳ 3,620,000</div>
          <span class="text-[10px] text-gray-400 mt-2 block">Phase 1 & 2 Approved Bills</span>
        </div>

        <div class="bg-navy-dark p-6 rounded-xl border border-navy-light shadow-md border-l-4 border-l-flame">
          <span class="text-xs font-bold uppercase text-gray-400 block mb-1">Unbilled Stock Balance</span>
          <div class="text-3xl font-black text-flame">৳ 1,230,000</div>
          <span class="text-[10px] text-flame mt-2 block font-semibold">Financial Risk Value to Reconcile</span>
        </div>
      </div>

      <!-- Quick Action Modules -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Document OCR Parser & PO Importer -->
        <div class="bg-navy-dark p-6 rounded-xl border border-navy-light space-y-4">
          <div class="flex items-center space-x-3 text-flame mb-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
            <h2 class="text-lg font-bold uppercase text-white">Document Auto-Importer</h2>
          </div>
          <p class="text-xs text-gray-300">
            Rapidly extract line items from PDF/Image POs, Delivery Challans, and R/A Bills. Auto-detects site names and pre-fills PO numbers (FM-XXXX).
          </p>

          <div class="border-2 border-dashed border-navy-light rounded-lg p-6 text-center hover:border-flame transition-colors cursor-pointer bg-navy/50">
            <svg class="w-8 h-8 mx-auto text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
            <span class="text-xs font-bold text-gray-300 block">Drop PO or Delivery Challan PDF</span>
            <span class="text-[10px] text-gray-500 block mt-1">Automatic line item parser</span>
          </div>
        </div>

        <!-- Site Material Reconciliation Table -->
        <div class="lg:col-span-2 bg-navy-dark p-6 rounded-xl border border-navy-light space-y-4">
          <div class="flex items-center justify-between mb-2">
            <h2 class="text-lg font-bold uppercase text-white">Developer Site Reconciliation</h2>
            <span class="text-xs text-gray-400 font-mono">Real-time Stock vs. Billed Qty</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-gray-300">
              <thead class="bg-navy text-flame font-bold uppercase text-[10px]">
                <tr>
                  <th class="p-3">Site / Client</th>
                  <th class="p-3">Item Name</th>
                  <th class="p-3">Supplied Qty</th>
                  <th class="p-3">Billed Qty</th>
                  <th class="p-3">Stock Balance</th>
                  <th class="p-3">Risk Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-navy-light">
                <tr class="hover:bg-navy/40">
                  <td class="p-3 font-bold text-white">BTI City Pointe-F</td>
                  <td class="p-3">4" Seamless Pipe (Sched 40)</td>
                  <td class="p-3">450 Pcs</td>
                  <td class="p-3 font-semibold text-green-400">300 Pcs</td>
                  <td class="p-3 font-bold text-flame">150 Pcs</td>
                  <td class="p-3"><span class="px-2 py-0.5 bg-yellow-500/20 text-yellow-300 text-[10px] font-bold rounded">Unbilled 33%</span></td>
                </tr>

                <tr class="hover:bg-navy/40">
                  <td class="p-3 font-bold text-white">BTI City Pointe-F</td>
                  <td class="p-3">ABC Dry Powder 6kg Extinguisher</td>
                  <td class="p-3">80 Pcs</td>
                  <td class="p-3 font-semibold text-green-400">80 Pcs</td>
                  <td class="p-3 font-bold text-green-400">0 Pcs</td>
                  <td class="p-3"><span class="px-2 py-0.5 bg-green-500/20 text-green-400 text-[10px] font-bold rounded">Fully Reconciled</span></td>
                </tr>

                <tr class="hover:bg-navy/40">
                  <td class="p-3 font-bold text-white">BRAC University Campus</td>
                  <td class="p-3">Fire Hose Reel & Cabinet Box</td>
                  <td class="p-3">25 Sets</td>
                  <td class="p-3 font-semibold text-green-400">15 Sets</td>
                  <td class="p-3 font-bold text-flame">10 Sets</td>
                  <td class="p-3"><span class="px-2 py-0.5 bg-flame/20 text-flame text-[10px] font-bold rounded">Action Required</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>
  </div>
</Layout>
