---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="E-Commerce Storefront | N.I. Engineering Services"
  description="Reserved for Future E-Commerce Storefront at shop.niengineeringbd.com"
>
  <div class="min-h-screen bg-clean text-navy flex flex-col justify-center items-center py-16 px-4">
    <div class="max-w-2xl w-full bg-white p-8 sm:p-12 rounded-2xl border border-clean-border shadow-2xl text-center">
      <div class="w-16 h-16 bg-flame/10 text-flame rounded-2xl flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
      </div>

      <span class="text-xs font-black uppercase text-flame tracking-widest block mb-2">shop.niengineeringbd.com</span>
      <h1 class="text-3xl font-extrabold uppercase tracking-tight text-navy mb-4">E-Commerce Storefront</h1>
      <span class="inline-block px-3 py-1 bg-yellow-100 text-yellow-800 text-xs font-bold uppercase rounded-full mb-6">
        Reserved for Phase 2 Expansion
      </span>

      <p class="text-sm text-gray-600 leading-relaxed mb-8">
        Online ordering portal for fire extinguishers, replacement cartridges, personal safety suits, alarm bells, and CCTV accessories with instant quotation checkout.
      </p>

      <a href="/" class="inline-flex items-center px-6 py-3 bg-navy hover:bg-navy-dark text-white text-xs font-extrabold uppercase tracking-wider rounded shadow transition-all">
        &larr; Return to Main Marketing Site
      </a>
    </div>
  </div>
</Layout>
