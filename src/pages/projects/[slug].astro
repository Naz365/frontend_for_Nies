---
import Layout from '../../layouts/Layout.astro';
import { fetchProjects, type Project } from '../../lib/api';

export async function getStaticPaths() {
  const projects = await fetchProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | N.I. Engineering Services`}>
  <section class="bg-navy text-white py-16 border-b border-flame">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-extrabold uppercase text-flame tracking-widest block mb-2">{project.category}</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-white">{project.title}</h1>
      <p class="mt-2 text-sm text-gray-300">Client: <span class="font-bold text-white">{project.client}</span></p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-xl overflow-hidden shadow-2xl border border-clean-border mb-8">
        <img src={project.image} alt={project.title} class="w-full h-auto object-cover max-h-[500px]" />
      </div>
      <div class="prose max-w-none text-navy">
        <h2 class="text-2xl font-bold uppercase mb-4">Project Overview</h2>
        <p class="text-gray-700 leading-relaxed">{project.description}</p>
      </div>
    </div>
  </section>
</Layout>
