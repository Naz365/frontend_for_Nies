---
import Layout from '../../layouts/Layout.astro';
import { fetchBlogPosts, type BlogPost } from '../../lib/api';

export async function getStaticPaths() {
  const posts = await fetchBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<Layout title={`${post.title} | N.I. Engineering Services`}>
  <section class="bg-navy text-white py-16 border-b border-flame">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-extrabold uppercase text-flame tracking-widest block mb-2">{post.published_at} • {post.author}</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">{post.title}</h1>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      {post.thumbnail && (
        <div class="rounded-xl overflow-hidden shadow-lg mb-8">
          <img src={post.thumbnail} alt={post.title} class="w-full h-auto object-cover max-h-[400px]" />
        </div>
      )}
      <div class="prose max-w-none text-navy leading-relaxed" set:html={post.content} />
    </div>
  </section>
</Layout>
