---
import Layout from '../layouts/Layout.astro';
import { FALLBACK_PRODUCTS, type Product } from '../lib/api';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title="Fire Safety & Security Equipment Shop Dhaka | Buy Online N.I. Engineering"
  description="Buy ABC Dry Powder, CO2 Extinguishers, Smoke Detectors, CCTV & Access Control Online in Dhaka. Best Price Guarantee, Instant Delivery & Certified Refilling."
>
  <!-- Hero Shop Banner -->
  <section class="bg-navy text-white py-14 border-b border-flame relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="inline-block px-3 py-1 bg-flame text-white text-[10px] sm:text-xs font-black uppercase tracking-widest rounded mb-3">
        Official Store & Equipment Pricing
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-white">
        Fire Safety & Security <span class="text-flame">E-Commerce Store</span>
      </h1>
      <p class="mt-3 text-xs sm:text-sm text-gray-300 max-w-2xl mx-auto leading-relaxed">
        Order certified fire extinguishers, chemical refilling packages, smoke alarms, CCTV cameras & access control systems online with instant delivery inside Dhaka.
      </p>

      <!-- Cart Quick Bar Toggle -->
      <div class="mt-6 flex justify-center items-center space-x-4">
        <button
          id="btn-open-cart"
          type="button"
          class="inline-flex items-center px-6 py-3 bg-flame hover:bg-flame-hover text-white text-xs font-extrabold uppercase tracking-wider rounded-lg shadow-lg transition-all duration-200"
        >
          <span class="mr-2">🛒 View Cart</span>
          <span id="cart-count-badge" class="px-2 py-0.5 bg-white text-flame rounded-full font-black text-xs">0</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Filter & Search Controls -->
  <section class="bg-clean dark:bg-navy-dark border-b border-clean-border dark:border-navy-light py-6 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        
        <!-- Search Input -->
        <div class="w-full md:w-80 relative">
          <input 
            type="text" 
            id="shop-search-input" 
            placeholder="Search equipment, CO2, smoke alarm..."
            class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-navy-light text-navy dark:text-gray-100 border border-clean-border dark:border-navy-light rounded-lg text-xs font-semibold focus:outline-none focus:border-flame shadow-sm"
          />
          <svg class="w-4 h-4 text-gray-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>

        <!-- Category Filters -->
        <div class="flex flex-wrap justify-center gap-2" id="shop-category-filters">
          <button type="button" data-cat="all" class="shop-cat-btn px-4 py-2 text-xs font-bold uppercase rounded-lg bg-flame text-white shadow">All Equipment</button>
          <button type="button" data-cat="fire-extinguishers" class="shop-cat-btn px-4 py-2 text-xs font-bold uppercase rounded-lg bg-white dark:bg-navy-light text-navy dark:text-gray-200 border border-clean-border dark:border-navy-light hover:bg-flame hover:text-white transition-all">Extinguishers</button>
          <button type="button" data-cat="suppression-system" class="shop-cat-btn px-4 py-2 text-xs font-bold uppercase rounded-lg bg-white dark:bg-navy-light text-navy dark:text-gray-200 border border-clean-border dark:border-navy-light hover:bg-flame hover:text-white transition-all">Suppression</button>
          <button type="button" data-cat="alarm-systems" class="shop-cat-btn px-4 py-2 text-xs font-bold uppercase rounded-lg bg-white dark:bg-navy-light text-navy dark:text-gray-200 border border-clean-border dark:border-navy-light hover:bg-flame hover:text-white transition-all">Alarms</button>
          <button type="button" data-cat="cctv" class="shop-cat-btn px-4 py-2 text-xs font-bold uppercase rounded-lg bg-white dark:bg-navy-light text-navy dark:text-gray-200 border border-clean-border dark:border-navy-light hover:bg-flame hover:text-white transition-all">CCTV</button>
          <button type="button" data-cat="access-control" class="shop-cat-btn px-4 py-2 text-xs font-bold uppercase rounded-lg bg-white dark:bg-navy-light text-navy dark:text-gray-200 border border-clean-border dark:border-navy-light hover:bg-flame hover:text-white transition-all">Access Control</button>
        </div>

        <!-- Sort Select -->
        <div class="w-full md:w-48">
          <select id="shop-sort-select" class="w-full px-3 py-2.5 bg-white dark:bg-navy-light text-navy dark:text-gray-100 border border-clean-border dark:border-navy-light rounded-lg text-xs font-semibold focus:outline-none focus:border-flame">
            <option value="featured">Featured Products</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
          </select>
        </div>

      </div>
    </div>
  </section>

  <!-- Product Catalog Grid -->
  <section class="py-12 bg-white dark:bg-navy min-h-[600px] transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center justify-between border-b border-clean-border dark:border-navy-light pb-4 mb-8">
        <h2 class="text-xl font-extrabold uppercase text-navy dark:text-white tracking-tight">Available Products & Prices</h2>
        <span id="shop-items-badge" class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase">Loading Catalog...</span>
      </div>

      <!-- Grid Container -->
      <div id="shop-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <!-- Dynamically rendered via client JS -->
      </div>

    </div>
  </section>

  <!-- SHOPPING CART DRAWER SLIDE-OVER -->
  <div id="cart-drawer-backdrop" class="fixed inset-0 z-50 bg-navy/80 backdrop-blur-sm hidden transition-opacity">
    <div class="fixed inset-y-0 right-0 max-w-full flex">
      <div class="w-screen max-w-md bg-white dark:bg-navy-dark shadow-2xl border-l border-clean-border dark:border-navy-light flex flex-col">
        
        <!-- Drawer Header -->
        <div class="p-6 bg-navy text-white flex items-center justify-between border-b border-flame">
          <div class="flex items-center space-x-2">
            <span class="text-xl">🛒</span>
            <h3 class="text-lg font-extrabold uppercase tracking-wide">Your Order Cart</h3>
          </div>
          <button id="btn-close-cart" class="w-8 h-8 rounded-full bg-white/10 hover:bg-flame text-white flex items-center justify-center font-bold text-sm">
            ✕
          </button>
        </div>

        <!-- Cart Items List -->
        <div id="cart-items-container" class="flex-grow p-6 overflow-y-auto space-y-4">
          <!-- Populated via JS -->
        </div>

        <!-- Drawer Footer Checkout -->
        <div class="p-6 border-t border-clean-border dark:border-navy-light bg-clean dark:bg-navy-light space-y-4">
          <div class="flex items-center justify-between text-sm">
            <span class="font-bold text-gray-600 dark:text-gray-300 uppercase">Total Amount:</span>
            <span id="cart-total-price" class="text-2xl font-black text-flame">৳ 0 BDT</span>
          </div>

          <div class="space-y-2">
            <button id="btn-proceed-checkout" class="w-full py-3.5 bg-flame hover:bg-flame-hover text-white text-xs font-extrabold uppercase tracking-wider rounded-lg shadow-lg transition-all">
              Proceed To Checkout →
            </button>
            <button id="btn-clear-cart" class="w-full py-2 bg-gray-200 dark:bg-navy hover:bg-gray-300 text-gray-700 dark:text-gray-300 text-[11px] font-bold uppercase rounded">
              Clear Cart
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- CHECKOUT MODAL -->
  <div id="checkout-modal" class="fixed inset-0 z-50 bg-navy/90 backdrop-blur-md hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-navy-dark max-w-lg w-full rounded-2xl border border-clean-border dark:border-navy-light shadow-2xl p-6 sm:p-8 space-y-6 relative text-navy dark:text-gray-100">
      <button id="btn-close-checkout" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-clean dark:bg-navy-light hover:bg-flame hover:text-white flex items-center justify-center font-bold">
        ✕
      </button>

      <div>
        <span class="text-[10px] font-black uppercase text-flame tracking-widest block mb-1">Fast Dhaka Delivery</span>
        <h2 class="text-2xl font-extrabold uppercase text-navy dark:text-white">Order Checkout</h2>
      </div>

      <div id="checkout-alert" class="hidden p-3 rounded text-xs font-bold bg-green-500/10 border border-green-500/30 text-green-700 dark:text-green-400">
        🎉 Order placed successfully! Our team will call you shortly to confirm delivery.
      </div>

      <form id="checkout-form" class="space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase mb-1">Full Name *</label>
          <input type="text" id="cust-name" required placeholder="e.g. Arman Hossain" class="w-full px-4 py-2.5 text-xs border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light rounded-lg focus:outline-none focus:border-flame font-medium" />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase mb-1">Phone Number (Dhaka Delivery) *</label>
          <input type="tel" id="cust-phone" required placeholder="+880 1700 000000" class="w-full px-4 py-2.5 text-xs border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light rounded-lg focus:outline-none focus:border-flame font-medium" />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase mb-1">Delivery Address *</label>
          <textarea id="cust-address" rows="2" required placeholder="House No, Road, Middle Badda / Gulshan / Uttara / Dhanmondi, Dhaka" class="w-full px-4 py-2.5 text-xs border border-clean-border dark:border-navy-light bg-white dark:bg-navy-light rounded-lg focus:outline-none focus:border-flame font-medium"></textarea>
        </div>

        <div class="p-3 bg-clean dark:bg-navy-light rounded-lg border border-clean-border dark:border-navy-light flex justify-between items-center text-xs">
          <span class="font-bold uppercase text-gray-500 dark:text-gray-300">Payable Total:</span>
          <span id="checkout-payable-total" class="font-extrabold text-flame text-sm">৳ 0 BDT</span>
        </div>

        <button type="submit" class="w-full py-3.5 bg-flame hover:bg-flame-hover text-white text-xs font-extrabold uppercase tracking-wider rounded-lg shadow">
          Confirm Order (Cash on Delivery)
        </button>
      </form>
    </div>
  </div>
</Layout>

<script is:inline>
  const PRODUCTS_STORAGE_KEY = 'nies_custom_products';
  const CART_STORAGE_KEY = 'nies_shopping_cart';

  // Default Fallback Catalog
  const DEFAULT_CATALOG = [
    {
      id: 1,
      title: "ABC Dry Chemical Powder Extinguisher (6kg)",
      slug: "abc-dry-powder-extinguisher-6kg",
      category_slug: "fire-extinguishers",
      category_name: "Fire Extinguishers",
      price: 1450,
      original_price: 1800,
      in_stock: true,
      image: "/frontend_for_Nies/wp-content/uploads/2017/05/fire-extinguishers1.jpg",
      description: "Multipurpose Class A, B, C fire extinguisher filled with 90% MAP powder."
    },
    {
      id: 2,
      title: "Carbon Dioxide CO2 Extinguisher (3kg)",
      slug: "co2-fire-extinguisher-3kg",
      category_slug: "fire-extinguishers",
      category_name: "Fire Extinguishers",
      price: 2800,
      original_price: 3200,
      in_stock: true,
      image: "/frontend_for_Nies/wp-content/uploads/2017/11/co2.png",
      description: "Residue-free CO2 gas cylinder designed specifically for electrical server rooms."
    },
    {
      id: 3,
      title: "AFFF Mechanical Foam Extinguisher (9L)",
      slug: "afff-foam-fire-extinguisher-9l",
      category_slug: "fire-extinguishers",
      category_name: "Fire Extinguishers",
      price: 2200,
      original_price: 2600,
      in_stock: true,
      image: "/frontend_for_Nies/wp-content/uploads/2017/05/fire-extinguishers1.jpg",
      description: "Aqueous Film Forming Foam ideal for flammable fuel and oil hazards."
    },
    {
      id: 4,
      title: "Clean Agent HFC-227ea Extinguisher (3kg)",
      slug: "clean-agent-hfc227ea-3kg",
      category_slug: "suppression-system",
      category_name: "Suppression System",
      price: 4500,
      original_price: 5200,
      in_stock: true,
      image: "/frontend_for_Nies/wp-content/uploads/2017/11/fire-suppression-system.jpg",
      description: "Zero ozone depletion clean agent for computer rooms and telecommunication hubs."
    },
    {
      id: 5,
      title: "Automatic Optical Smoke & Heat Detector",
      slug: "automatic-optical-smoke-detector",
      category_slug: "alarm-systems",
      category_name: "Alarm Systems",
      price: 850,
      original_price: 1100,
      in_stock: true,
      image: "/frontend_for_Nies/wp-content/uploads/2017/05/fire-detection-alarm-system.jpg",
      description: "High-sensitivity photoelectric smoke detector unit compatible with central alarm panels."
    },
    {
      id: 6,
      title: "Commercial Heavy Duty Fire Hose Reel (30m)",
      slug: "commercial-fire-hose-reel-30m",
      category_slug: "firefighting-equipment",
      category_name: "Firefighting Equipment",
      price: 8500,
      original_price: 9800,
      in_stock: true,
      image: "/frontend_for_Nies/wp-content/uploads/2017/05/DFRS_Generic_Hero_Banner_78_May13.jpg",
      description: "High-pressure swinging wall mounted hose reel with solid brass jet nozzle."
    },
    {
      id: 7,
      title: "4K HD Outdoor IR Surveillance CCTV Camera",
      slug: "4k-hd-surveillance-cctv-camera",
      category_slug: "cctv",
      category_name: "CCTV",
      price: 3200,
      original_price: 3900,
      in_stock: true,
      image: "/frontend_for_Nies/wp-content/uploads/2017/11/brac-university.jpg",
      description: "Weatherproof IP67 dome camera with night vision infrared LED up to 30m."
    },
    {
      id: 8,
      title: "Biometric Fingerprint & RFID Access Control",
      slug: "biometric-fingerprint-rfid-access-control",
      category_slug: "access-control",
      category_name: "Access Control",
      price: 6500,
      original_price: 7800,
      in_stock: true,
      image: "/frontend_for_Nies/wp-content/uploads/2017/11/AccessControlSystems.jpg",
      description: "Time attendance and door lock access control terminal."
    }
  ];

  // Get Store Products Merged with Admin Custom Additions
  function getShopProducts() {
    try {
      const stored = localStorage.getItem(PRODUCTS_STORAGE_KEY);
      if (!stored) return DEFAULT_CATALOG;
      const parsed = JSON.parse(stored);
      // Merge defaults
      DEFAULT_CATALOG.forEach(dp => {
        if (!parsed.some(p => p.id === dp.id || p.slug === dp.slug)) {
          parsed.push(dp);
        }
      });
      return parsed;
    } catch (e) {
      return DEFAULT_CATALOG;
    }
  }

  // Shopping Cart Management
  function getCart() {
    try {
      const c = localStorage.getItem(CART_STORAGE_KEY);
      return c ? JSON.parse(c) : [];
    } catch (e) {
      return [];
    }
  }

  function saveCart(cart) {
    localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
    updateCartUI();
  }

  function addToCart(product) {
    const cart = getCart();
    const existing = cart.find(item => item.id === product.id);
    if (existing) {
      existing.qty += 1;
    } else {
      cart.push({ ...product, qty: 1 });
    }
    saveCart(cart);
    openCart();
  }

  function updateCartUI() {
    const cart = getCart();
    const countBadge = document.getElementById('cart-count-badge');
    const totalDisplay = document.getElementById('cart-total-price');
    const checkoutTotalDisplay = document.getElementById('checkout-payable-total');
    const container = document.getElementById('cart-items-container');

    const totalCount = cart.reduce((acc, item) => acc + item.qty, 0);
    const totalPrice = cart.reduce((acc, item) => acc + (item.price * item.qty), 0);

    if (countBadge) countBadge.textContent = String(totalCount);
    if (totalDisplay) totalDisplay.textContent = `৳ ${totalPrice.toLocaleString()} BDT`;
    if (checkoutTotalDisplay) checkoutTotalDisplay.textContent = `৳ ${totalPrice.toLocaleString()} BDT`;

    if (!container) return;

    if (cart.length === 0) {
      container.innerHTML = `
        <div class="text-center py-12 space-y-3">
          <div class="text-4xl">🛒</div>
          <p class="text-xs font-bold text-gray-500 dark:text-gray-400">Your cart is currently empty.</p>
        </div>
      `;
      return;
    }

    container.innerHTML = cart.map(item => `
      <div class="p-3 bg-clean dark:bg-navy-light rounded-xl border border-clean-border dark:border-navy-light flex items-center justify-between gap-3">
        <img src="${item.image}" alt="${item.title}" class="w-14 h-14 object-cover rounded border" />
        <div class="flex-grow min-w-0">
          <h4 class="text-xs font-bold text-navy dark:text-white line-clamp-1">${item.title}</h4>
          <p class="text-xs font-black text-flame mt-0.5">৳ ${(item.price * item.qty).toLocaleString()} BDT</p>
          <p class="text-[10px] text-gray-400">৳ ${item.price.toLocaleString()} each</p>
        </div>
        <div class="flex items-center space-x-1.5 flex-shrink-0">
          <button data-cart-minus="${item.id}" class="w-6 h-6 rounded bg-gray-200 dark:bg-navy text-navy dark:text-white font-black text-xs hover:bg-flame hover:text-white transition-colors">-</button>
          <span class="text-xs font-bold px-1">${item.qty}</span>
          <button data-cart-plus="${item.id}" class="w-6 h-6 rounded bg-gray-200 dark:bg-navy text-navy dark:text-white font-black text-xs hover:bg-flame hover:text-white transition-colors">+</button>
        </div>
      </div>
    `).join('');

    // Quantity Plus & Minus Listeners
    container.querySelectorAll('[data-cart-minus]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = parseInt(e.currentTarget.getAttribute('data-cart-minus'), 10);
        let cart = getCart();
        const item = cart.find(i => i.id === id);
        if (item) {
          item.qty -= 1;
          if (item.qty <= 0) cart = cart.filter(i => i.id !== id);
          saveCart(cart);
        }
      });
    });

    container.querySelectorAll('[data-cart-plus]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = parseInt(e.currentTarget.getAttribute('data-cart-plus'), 10);
        let cart = getCart();
        const item = cart.find(i => i.id === id);
        if (item) {
          item.qty += 1;
          saveCart(cart);
        }
      });
    });
  }

  // Cart Drawer UI Toggles
  const drawer = document.getElementById('cart-drawer-backdrop');
  function openCart() { drawer?.classList.remove('hidden'); }
  function closeCart() { drawer?.classList.add('hidden'); }

  document.getElementById('btn-open-cart')?.addEventListener('click', openCart);
  document.getElementById('btn-close-cart')?.addEventListener('click', closeCart);
  document.getElementById('btn-clear-cart')?.addEventListener('click', () => saveCart([]));

  // Checkout Modal Toggles
  const checkoutModal = document.getElementById('checkout-modal');
  document.getElementById('btn-proceed-checkout')?.addEventListener('click', () => {
    const cart = getCart();
    if (cart.length === 0) {
      alert("Your cart is empty. Add products before checking out!");
      return;
    }
    closeCart();
    checkoutModal?.classList.remove('hidden');
  });

  document.getElementById('btn-close-checkout')?.addEventListener('click', () => {
    checkoutModal?.classList.add('hidden');
  });

  // Checkout Form Submission
  document.getElementById('checkout-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const alertBox = document.getElementById('checkout-alert');
    if (alertBox) alertBox.classList.remove('hidden');
    saveCart([]);
    setTimeout(() => {
      alertBox?.classList.add('hidden');
      checkoutModal?.classList.add('hidden');
    }, 2500);
  });

  // Render Product Grid with Filters and Search
  let currentCategory = 'all';
  let searchQuery = '';
  let sortBy = 'featured';

  function renderGrid() {
    const grid = document.getElementById('shop-grid');
    const itemsBadge = document.getElementById('shop-items-badge');
    let products = getShopProducts();

    // Search filter
    if (searchQuery) {
      products = products.filter(p => p.title.toLowerCase().includes(searchQuery) || p.description.toLowerCase().includes(searchQuery));
    }

    // Category filter
    if (currentCategory !== 'all') {
      products = products.filter(p => p.category_slug === currentCategory);
    }

    // Sorting
    if (sortBy === 'price-low') {
      products.sort((a, b) => a.price - b.price);
    } else if (sortBy === 'price-high') {
      products.sort((a, b) => b.price - a.price);
    }

    if (itemsBadge) itemsBadge.textContent = `Showing ${products.length} Products`;
    if (!grid) return;

    if (products.length === 0) {
      grid.innerHTML = `
        <div class="col-span-full py-16 text-center space-y-3">
          <p class="text-sm font-bold text-navy dark:text-white">No equipment items found matching your filter.</p>
          <p class="text-xs text-gray-500">Try searching for "extinguisher", "co2", or "cctv".</p>
        </div>
      `;
      return;
    }

    grid.innerHTML = products.map(p => `
      <div class="bg-white dark:bg-navy-light border border-clean-border dark:border-navy-light rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
        <div>
          <!-- Thumbnail & Stock Tag -->
          <div class="h-48 overflow-hidden relative bg-gray-100 dark:bg-navy">
            <img src="${p.image}" alt="${p.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <span class="absolute top-3 left-3 bg-navy dark:bg-flame text-white text-[9px] font-extrabold uppercase px-2.5 py-0.5 rounded shadow">
              ${p.category_name || p.category_slug.replace('-', ' ')}
            </span>
            <span class="absolute top-3 right-3 bg-green-600 text-white text-[9px] font-black uppercase px-2 py-0.5 rounded shadow flex items-center space-x-1">
              <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
              <span>In Stock</span>
            </span>
          </div>

          <!-- Product Details -->
          <div class="p-5 space-y-2">
            <h3 class="text-sm font-bold text-navy dark:text-white line-clamp-1 uppercase tracking-tight">${p.title}</h3>
            <p class="text-xs text-gray-600 dark:text-gray-300 leading-relaxed line-clamp-2">${p.description}</p>
            
            <!-- Price Display -->
            <div class="pt-2 flex items-baseline space-x-2">
              <span class="text-lg font-black text-flame">৳ ${p.price.toLocaleString()} BDT</span>
              ${p.original_price ? `<span class="text-xs text-gray-400 line-through">৳ ${p.original_price.toLocaleString()}</span>` : ''}
            </div>
          </div>
        </div>

        <!-- Add to Cart / Order CTA Buttons -->
        <div class="p-5 pt-0 grid grid-cols-2 gap-2">
          <button data-buy-now="${p.id}" class="py-2.5 bg-navy dark:bg-navy-dark hover:bg-navy-light text-white text-[11px] font-extrabold uppercase rounded shadow transition-all">
            Buy Now ⚡
          </button>
          <button data-add-cart="${p.id}" class="py-2.5 bg-flame hover:bg-flame-hover text-white text-[11px] font-extrabold uppercase rounded shadow transition-all">
            Add Cart 🛒
          </button>
        </div>
      </div>
    `).join('');

    // Attach Event Listeners to Buttons
    grid.querySelectorAll('[data-add-cart]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = parseInt(e.currentTarget.getAttribute('data-add-cart'), 10);
        const prod = getShopProducts().find(item => item.id === id);
        if (prod) addToCart(prod);
      });
    });

    grid.querySelectorAll('[data-buy-now]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = parseInt(e.currentTarget.getAttribute('data-buy-now'), 10);
        const prod = getShopProducts().find(item => item.id === id);
        if (prod) {
          addToCart(prod);
          openCart();
        }
      });
    });
  }

  // Filter Listeners
  document.getElementById('shop-search-input')?.addEventListener('input', (e) => {
    searchQuery = e.target.value.toLowerCase().trim();
    renderGrid();
  });

  document.getElementById('shop-sort-select')?.addEventListener('change', (e) => {
    sortBy = e.target.value;
    renderGrid();
  });

  document.querySelectorAll('.shop-cat-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.shop-cat-btn').forEach(b => {
        b.className = 'shop-cat-btn px-4 py-2 text-xs font-bold uppercase rounded-lg bg-white dark:bg-navy-light text-navy dark:text-gray-200 border border-clean-border dark:border-navy-light hover:bg-flame hover:text-white transition-all';
      });
      e.currentTarget.className = 'shop-cat-btn px-4 py-2 text-xs font-bold uppercase rounded-lg bg-flame text-white shadow';
      currentCategory = e.currentTarget.getAttribute('data-cat') || 'all';
      renderGrid();
    });
  });

  // Initial Load
  updateCartUI();
  renderGrid();
</script>
