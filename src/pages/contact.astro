---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout 
  title="Contact | N. I. Engineering Services"
  description="Contact N. I. Engineering Services at GA-85 Middle Badda, Gulshan, Dhaka. Call +880 1711 135 731 for fire safety inquiries."
>
  <section class="bg-navy text-white py-16 border-b border-flame">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-extrabold uppercase text-flame tracking-widest block mb-2">24/7 Technical Inquiries</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold uppercase tracking-tight text-white">Contact Us</h1>
      <p class="mt-4 text-sm sm:text-base text-gray-300 max-w-2xl mx-auto">
        Reach out to our engineering team for fire equipment orders, extinguisher refilling schedules, CCTV installation, or site audits.
      </p>
    </div>
  </section>

  <ContactForm />
</Layout>
